                }, 
                {
                    "pos": [0, 64, 0], 
                    "is": { "id": "minecraft:hopper", "nbt": {"Items[0].count": 1} }
                }
            ]
        }, 
        {
            "at": 25, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 63, 0], 
                    "is": {
                        "id": "minecraft:chest", 
