{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:barrel"], 
    "name": "Barrel Default State", 
    "description": "A barrel placed without properties defaults to facing north and closed, and explicit properties are kept.", 
    "tags": ["block-entity", "container", "barrel", "block-state"], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 0, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:barrel"                                } }, 
                { "pos": [1, 0, 0], "block": {"id": "minecraft:barrel", "facing": "west", "open": true} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:barrel", "facing": "north", "open": false} }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:barrel", "facing": "west" , "open": true } }  
            ]
        }
    ]
}

