{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:hopper", "minecraft:barrel", "minecraft:cobblestone"], 
    "name": "Hopper Transfers Cobblestone To Barrel", 
    "description": "A hopper above a barrel pushes its cobblestone into the barrel one item every eight ticks.", 
    "tags": ["block-entity", "container", "barrel", "hopper", "item-transfer"], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:barrel", "facing": "up"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id": "minecraft:hopper", 
                        "facing": "down", 
                        "nbt": {"Items": "[{Slot: 0b, count: 2, id: \"minecraft:cobblestone\"}]", "TransferCooldown": 0}
                    }
                }
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id": "minecraft:barrel", 
                        "nbt": {"Items[0].id": "minecraft:cobblestone", "Items[0].count": 1}
                    }
                }, 
                {
                    "pos": [0, 1, 0], 
                    "is": { "id": "minecraft:hopper", "nbt": {"Items[0].count": 1} }
                }
            ]
        }, 
        {
            "at": 9, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id": "minecraft:barrel", 
                        "nbt": {"Items[0].id": "minecraft:cobblestone", "Items[0].count": 2}
                    }
                }, 
                {
                    "pos": [0, 1, 0], 
                    "is": { "id": "minecraft:hopper", "nbt": {"Items": []} }
                }
            ]
        }
    ]
}

