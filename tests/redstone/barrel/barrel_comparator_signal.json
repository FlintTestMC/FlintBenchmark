{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:barrel", "minecraft:comparator", "minecraft:stone"], 
    "name": "Barrel Comparator Signal", 
    "description": "A comparator reads 0 from an empty barrel, 1 from a single item or one full stack, 2 from two full stacks and 3 from four full stacks.", 
    "tags": ["block-entity", "container", "barrel", "comparator", "analog-output", "redstone"], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 4] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 0, 0], "block": {"id": "minecraft:stone"                       } }, 
                { "pos": [1, 0, 1], "block": {"id": "minecraft:stone"                       } }, 
                { "pos": [1, 0, 2], "block": {"id": "minecraft:stone"                       } }, 
                { "pos": [1, 0, 3], "block": {"id": "minecraft:stone"                       } }, 
                { "pos": [1, 0, 4], "block": {"id": "minecraft:stone"                       } }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:comparator", "facing": "west"} }, 
                { "pos": [1, 1, 1], "block": {"id": "minecraft:comparator", "facing": "west"} }, 
                { "pos": [1, 1, 2], "block": {"id": "minecraft:comparator", "facing": "west"} }, 
                { "pos": [1, 1, 3], "block": {"id": "minecraft:comparator", "facing": "west"} }, 
                { "pos": [1, 1, 4], "block": {"id": "minecraft:comparator", "facing": "west"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:barrel", "facing": "up"} }, 
                {
                    "pos": [0, 1, 1], 
                    "block": {
                        "id": "minecraft:barrel", 
                        "facing": "up", 
                        "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:stone\"}]"}
                    }
                }, 
                {
                    "pos": [0, 1, 2], 
                    "block": {
                        "id": "minecraft:barrel", 
                        "facing": "up", 
                        "nbt": {"Items": "[{Slot: 0b, count: 64, id: \"minecraft:stone\"}]"}
                    }
                }, 
                {
                    "pos": [0, 1, 3], 
                    "block": {
                        "id": "minecraft:barrel", 
                        "facing": "up", 
                        "nbt": {
                            "Items": "[{Slot: 0b, count: 64, id: \"minecraft:stone\"}, {Slot: 1b, count: 64, id: \"minecraft:stone\"}]"
                        }
                    }
                }, 
                {
                    "pos": [0, 1, 4], 
                    "block": {
                        "id": "minecraft:barrel", 
                        "facing": "up", 
                        "nbt": {
                            "Items": "[{Slot: 0b, count: 64, id: \"minecraft:stone\"}, {Slot: 1b, count: 64, id: \"minecraft:stone\"}, {Slot: 2b, count: 64, id: \"minecraft:stone\"}, {Slot: 3b, count: 64, id: \"minecraft:stone\"}]"
                        }
                    }
                }
            ]
        }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 0} }
                }, 
                {
                    "pos": [1, 1, 1], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 1} }
                }, 
                {
                    "pos": [1, 1, 2], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 1} }
                }, 
                {
                    "pos": [1, 1, 3], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 2} }
                }, 
                {
                    "pos": [1, 1, 4], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 3} }
                }
            ]
