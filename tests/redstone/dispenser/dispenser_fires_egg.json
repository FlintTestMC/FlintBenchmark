{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:dispenser", "minecraft:egg", "minecraft:redstone_block"], 
    "name": "Dispenser Fires Egg", 
    "description": "A powered dispenser holding one egg fires it and ends up empty (ProjectileDispenseBehavior shrinks the stack by 1).", 
    "tags": ["redstone", "dispenser", "egg", "block-entity"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [1, 3, 5] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, -1, -1], [1, -1, 5] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 0], 
            "block": {
                "id": "minecraft:dispenser", 
                "facing": "south", 
                "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:egg\"}]"}
            }
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": { "id": "minecraft:dispenser", "nbt": {"Items[0].id": "minecraft:egg", "Items[0].count": 1} }
                }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 0, -1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": { "id": "minecraft:dispenser", "facing": "south", "triggered": true, "nbt": {"Items": "[]"} }
                }
            ]
        }
    ]
}

