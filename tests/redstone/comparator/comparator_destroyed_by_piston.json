{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "comparator_destroyed_by_piston", 
    "description": "A piston pushing a comparator destroys it instead of moving it.", 
    "tags": ["redstone", "comparator", "piston", "push-reaction"], 
    "minecraftIds": ["minecraft:comparator", "minecraft:piston", "minecraft:piston_head", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 1, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston"    , "facing": "east"} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:comparator", "facing": "east"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:comparator"} }
            ]
        }, 
        { "at": 3, "do": "place", "pos": [0, 1, -1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"     , "extended": true                  } }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head",                   "facing": "east"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"                                            } }  
            ]
        }
    ], 
    "breakpoints": []
}

