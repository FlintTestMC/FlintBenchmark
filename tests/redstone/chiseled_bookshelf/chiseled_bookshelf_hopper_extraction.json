{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "chiseled_bookshelf_hopper_extraction", 
    "description": "A hopper under a chiseled bookshelf pulls the stored books out one at a time starting with the lowest occupied slot and clears each slot's occupied flag.", 
    "tags": ["redstone", "chiseled-bookshelf", "hopper", "block-entity", "container", "item-transfer", "player"], 
    "minecraftIds": ["minecraft:chiseled_bookshelf", "minecraft:hopper", "minecraft:book", "minecraft:enchanted_book"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -3], [2, 3, 2] ]
        }, 
        "player": {
            "inventory": {
                "hotbar2": {"id": "minecraft:book"          , "count": 1}, 
                "hotbar3": {"id": "minecraft:enchanted_book", "count": 1}  
            }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 2, 0], 
            "block": {"id": "minecraft:chiseled_bookshelf", "facing": "north"}
        }, 
        {"at": 1, "do": "select_hotbar", "slot": 2}, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.83, 1.13, -1.5], "rot": [0, 0] }, 
        {"at": 1, "do": "interact"}, 
        {"at": 2, "do": "select_hotbar", "slot": 3}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 0.63, -1.5], "rot": [0, 0] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id": "minecraft:chiseled_bookshelf", 
                        "slot_0_occupied": true, 
                        "slot_1_occupied": false, 
                        "slot_2_occupied": false, 
                        "slot_3_occupied": false, 
                        "slot_4_occupied": true, 
                        "slot_5_occupied": false
                    }
                }
            ]
        }, 
        {
            "at": 3, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": { "id": "minecraft:hopper", "facing": "down", "nbt": {"TransferCooldown": 0} }
        }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id": "minecraft:chiseled_bookshelf", 
                        "slot_0_occupied": false, 
                        "slot_1_occupied": false, 
                        "slot_2_occupied": false, 
                        "slot_3_occupied": false, 
                        "slot_4_occupied": true, 
                        "slot_5_occupied": false
                    }
                }, 
                {
                    "pos": [0, 1, 0], 
                    "is": { "id": "minecraft:hopper", "nbt": {"Items[0].id": "minecraft:book", "Items[0].count": 1} }
                }
            ]
        }, 
        {
            "at": 20, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id": "minecraft:chiseled_bookshelf", 
                        "slot_0_occupied": false, 
                        "slot_1_occupied": false, 
                        "slot_2_occupied": false, 
                        "slot_3_occupied": false, 
                        "slot_4_occupied": false, 
                        "slot_5_occupied": false
                    }
                }, 
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:hopper", 
                        "nbt": {"Items[0].id": "minecraft:book", "Items[1].id": "minecraft:enchanted_book"}
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

