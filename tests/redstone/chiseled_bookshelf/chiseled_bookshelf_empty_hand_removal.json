{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "chiseled_bookshelf_empty_hand_removal", 
    "description": "With an empty hand, clicking an occupied slot returns exactly that stored book (enchanted or plain) to the inventory and clears its flag, while clicking an empty slot changes nothing.", 
