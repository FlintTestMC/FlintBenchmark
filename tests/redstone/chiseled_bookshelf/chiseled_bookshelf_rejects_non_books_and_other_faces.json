{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "chiseled_bookshelf_rejects_non_books_and_other_faces", 
    "description": "A stick aimed at an empty slot and a book used on the east, west, back or top face are not inserted: all slot flags stay false and the player keeps both stacks.", 
    "tags": ["redstone", "chiseled-bookshelf", "container", "edge-case", "player"], 
    "minecraftIds": ["minecraft:chiseled_bookshelf", "minecraft:book", "minecraft:stick"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -3], [2, 3, 2] ]
        }, 
        "player": {
            "inventory": {
                "hotbar1": {"id": "minecraft:stick", "count": 1}, 
                "hotbar2": {"id": "minecraft:book" , "count": 4}  
            }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 2, 0], 
            "block": {"id": "minecraft:chiseled_bookshelf", "facing": "north"}
        }, 
        {"at": 1, "do": "select_hotbar", "slot": 1}, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.83, 1.13, -1.5], "rot": [0, 0] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id": "minecraft:chiseled_bookshelf", 
                        "slot_0_occupied": false, 
                        "slot_1_occupied": false, 
                        "slot_2_occupied": false, 
                        "slot_3_occupied": false, 
                        "slot_4_occupied": false, 
                        "slot_5_occupied": false
                    }
                }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:stick", "count": 1} }
            ]
        }, 
        {"at": 2, "do": "select_hotbar", "slot": 2}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [1.5, 0.88, 0.5], "rot": [90, 0] }, 
        {"at": 2, "do": "interact"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [-1.5, 0.88, 0.5], "rot": [-90, 0] }, 
        {"at": 3, "do": "interact"}, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [0.5, 0.88, 1.5], "rot": [180, 0] }, 
        {"at": 4, "do": "interact"}, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 5, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id": "minecraft:chiseled_bookshelf", 
                        "slot_0_occupied": false, 
                        "slot_1_occupied": false, 
                        "slot_2_occupied": false, 
                        "slot_3_occupied": false, 
                        "slot_4_occupied": false, 
                        "slot_5_occupied": false
                    }
                }, 
                { "slot": "hotbar2", "is": {"id": "minecraft:book", "count": 4} }
            ]
        }
    ], 
    "breakpoints": []
}

