{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Oak Trapdoor Place Top Face", 
    "description": "Clicking the top face of a block places a closed, unpowered, dry bottom-half oak trapdoor facing opposite the player's look direction. Representative of all wooden trapdoors (oak, spruce, birch, jungle, acacia, dark_oak, pale_oak, mangrove, cherry, bamboo).", 
    "tags": ["trapdoor", "placement", "block-state"], 
    "minecraftIds": ["minecraft:oak_trapdoor"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"gamemode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:oak_trapdoor"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id"         : "minecraft:oak_trapdoor", 
                        "facing"     : "north"                 , 
                        "half"       : "bottom"                , 
                        "open"       : "false"                 , 
                        "powered"    : "false"                 , 
                        "waterlogged": "false"                   
                    }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

