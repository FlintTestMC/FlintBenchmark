{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Oak Trapdoor Hand Close While Powered", 
    "description": "A powered, open oak trapdoor can be closed by hand while staying powered; it stays closed while the signal is unchanged and also after the signal is removed.", 
    "tags": ["trapdoor", "redstone", "interaction"], 
    "minecraftIds": ["minecraft:oak_trapdoor"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, -1], [1, 1, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id"     : "minecraft:oak_trapdoor", 
                        "facing" : "north"                 , 
                        "half"   : "bottom"                , 
                        "open"   : "false"                 , 
                        "powered": "false"                   
                    }
                }
            ]
        }, 
        { "at": 1, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_trapdoor", "open": "true", "powered": "true"} }
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, -0.12, -1.5], "rot": [0, 0] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id"     : "minecraft:oak_trapdoor", 
                        "facing" : "north"                 , 
                        "half"   : "bottom"                , 
                        "open"   : "false"                 , 
                        "powered": "true"                    
                    }
                }
            ]
        }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_trapdoor", "open": "false", "powered": "true"} }
            ]
        }, 
        { "at": 8, "do": "remove", "pos": [1, 1, 0] }, 
        {
            "at": 9, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_trapdoor", "open": "false", "powered": "false"} }
            ]
        }
    ], 
    "breakpoints": []
}

