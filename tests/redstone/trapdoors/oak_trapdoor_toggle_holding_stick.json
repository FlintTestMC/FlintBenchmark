{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Oak Trapdoor Toggle Holding Stick", 
    "description": "Using an oak trapdoor while holding an item without a block-use action (a stick) still opens it, because the block's empty-hand use runs before the item.", 
    "tags": ["trapdoor", "interaction", "block-state"], 
    "minecraftIds": ["minecraft:oak_trapdoor"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"gamemode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {"id": "minecraft:oak_trapdoor", "facing": "north", "half": "bottom", "open": "false"}
                }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:stick"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id"     : "minecraft:oak_trapdoor", 
                        "facing" : "north"                 , 
                        "half"   : "bottom"                , 
                        "open"   : "true"                  , 
                        "powered": "false"                   
                    }
                }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:stick", "count": 1} }
            ]
        }
    ], 
    "breakpoints": []
}

