{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "oak_door_hand_toggle", 
    "description": "Right-clicking either half of a wooden door with an empty hand toggles both halves open and closed.", 
    "tags": ["redstone", "door", "block-state", "player", "interaction"], 
    "minecraftIds": ["minecraft:oak_door"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, 0], [5, 4, 4] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, 0], [5, 0, 4] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                {
                    "pos": [0, 2, 0], 
                    "block": {
                        "id"     : "minecraft:oak_door", 
                        "half"   : "upper"             , 
                        "facing" : "north"             , 
                        "hinge"  : "left"              , 
                        "open"   : "false"             , 
                        "powered": "false"               
                    }
                }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id"     : "minecraft:oak_door", 
                        "half"   : "lower"             , 
                        "facing" : "north"             , 
                        "hinge"  : "left"              , 
                        "open"   : "false"             , 
                        "powered": "false"               
                    }
                }, 
                {
                    "pos": [4, 2, 0], 
                    "block": {
                        "id"     : "minecraft:oak_door", 
                        "half"   : "upper"             , 
                        "facing" : "north"             , 
                        "hinge"  : "left"              , 
                        "open"   : "false"             , 
                        "powered": "false"               
                    }
                }, 
                {
                    "pos": [4, 1, 0], 
                    "block": {
                        "id"     : "minecraft:oak_door", 
                        "half"   : "lower"             , 
                        "facing" : "north"             , 
                        "hinge"  : "left"              , 
                        "open"   : "false"             , 
                        "powered": "false"               
                    }
                }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 2.5], "rot": [180, 40] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_door", "half": "lower", "open": "true"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:oak_door", "half": "upper", "open": "true"} }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.1, 1, 2.5], "rot": [180, 40] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_door", "half": "lower", "open": "false"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:oak_door", "half": "upper", "open": "false"} }  
            ]
        }, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [4.5, 1, 2.5], "rot": [180, 0] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [4, 1, 0], "is": {"id": "minecraft:oak_door", "half": "lower", "open": "true"} }, 
                { "pos": [4, 2, 0], "is": {"id": "minecraft:oak_door", "half": "upper", "open": "true"} }  
            ]
        }, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [4.1, 1, 2.5], "rot": [180, 0] }, 
        {"at": 4, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [4, 1, 0], "is": {"id": "minecraft:oak_door", "half": "lower", "open": "false"} }, 
                { "pos": [4, 2, 0], "is": {"id": "minecraft:oak_door", "half": "upper", "open": "false"} }  
            ]
        }
    ], 
    "breakpoints": []
