{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "oak_door_placement", 
    "description": "Survival placement of a door on stone creates a closed, unpowered lower and upper half facing the player and consumes the item. Representative for all wooden doors (acacia, bamboo, birch, cherry, crimson, dark_oak, jungle, mangrove, pale_oak, spruce, warped); crimson and warped differ only in not being ignitable by lava, which is not testable. ", 
    "tags": ["redstone", "door", "block-state", "player", "placement"], 
    "minecraftIds": ["minecraft:oak_door"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:oak_door", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [90, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id"     : "minecraft:oak_door", 
                        "half"   : "lower"             , 
                        "facing" : "west"              , 
                        "open"   : "false"             , 
                        "powered": "false"               
                    }
                }, 
                {
                    "pos": [0, 2, 0], 
                    "is": {
                        "id"     : "minecraft:oak_door", 
                        "half"   : "upper"             , 
                        "facing" : "west"              , 
                        "open"   : "false"             , 
                        "powered": "false"               
                    }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

