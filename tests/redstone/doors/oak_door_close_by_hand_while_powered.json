{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "oak_door_close_by_hand_while_powered", 
    "description": "A powered open door can still be closed by hand, after which it stays powered while closed.", 
    "tags": ["redstone", "door", "block-state", "player", "interaction", "redstone", "power"], 
    "minecraftIds": ["minecraft:oak_door", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, 0], [2, 4, 4] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, 0], [2, 0, 4] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                {
                    "pos": [0, 2, 0], 
                    "block": {
                        "id"     : "minecraft:oak_door", 
                        "half"   : "upper"             , 
                        "facing" : "north"             , 
                        "hinge"  : "left"              , 
                        "open"   : "false"             , 
                        "powered": "false"               
                    }
                }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id"     : "minecraft:oak_door", 
                        "half"   : "lower"             , 
                        "facing" : "north"             , 
                        "hinge"  : "left"              , 
                        "open"   : "false"             , 
                        "powered": "false"               
                    }
                }
            ]
        }, 
        { "at": 1, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:oak_door", "half": "lower", "open": "true", "powered": "true"}
                }, 
                {
                    "pos": [0, 2, 0], 
                    "is": {"id": "minecraft:oak_door", "half": "upper", "open": "true", "powered": "true"}
                }
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.1, 1, 2.5], "rot": [180, 40] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:oak_door", "half": "lower", "open": "false", "powered": "true"}
                }, 
                {
                    "pos": [0, 2, 0], 
                    "is": {"id": "minecraft:oak_door", "half": "upper", "open": "false", "powered": "true"}
                }
            ]
        }
    ], 
    "breakpoints": []
}

