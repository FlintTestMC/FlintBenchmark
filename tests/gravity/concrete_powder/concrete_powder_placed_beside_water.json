        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:water", "level": 0} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:white_concrete"            }                    }, 
                {                   "is": {"id": "minecraft:air"           , "count": 0}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
