{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "concrete_powder_placed_beside_water", 
    "description": "A player placing concrete powder next to a water source gets concrete immediately.", 
