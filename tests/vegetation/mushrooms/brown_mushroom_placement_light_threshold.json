{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "brown_mushroom_placement_light_threshold", 
    "description": "In a dark room lit by one glowstone, a brown mushroom cannot be placed at light level 13 (two blocks from the glowstone) but can at light level 12 (three blocks away).", 
    "tags": ["vegetation", "mushroom", "brown-mushroom", "placement", "light", "threshold", "player"], 
    "minecraftIds": ["minecraft:brown_mushroom", "minecraft:glowstone", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [7, 4, 1] ]
        }, 
        "player": {
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:brown_mushroom", "count": 2} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [7, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [6, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 5, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:glowstone"} }, 
        { "at": 8, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 8, "do": "interact"}, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"                       }                    }, 
                {                   "is": {"id": "minecraft:brown_mushroom", "count": 2}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 11, "do": "tp", "entity_alias": "player", "pos": [3.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 11, "do": "interact"}, 
        { "at": 11, "do": "tp", "entity_alias": "player", "pos": [3.5, 6, 0.5] }, 
        {
            "at": 14, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"                       }                    }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:brown_mushroom"            }                    }, 
                {                   "is": {"id": "minecraft:brown_mushroom", "count": 1}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 15, "do": "remove", "pos": [3, 1, 0] }
    ], 
    "breakpoints": []
}

