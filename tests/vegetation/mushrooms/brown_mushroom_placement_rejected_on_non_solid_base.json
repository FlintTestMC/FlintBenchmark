{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "brown_mushroom_placement_rejected_on_non_solid_base", 
    "description": "In a dark room a brown mushroom cannot be placed on glass because it does not render as a solid block, while placement on stone next to it works.", 
    "tags": ["vegetation", "mushroom", "brown-mushroom", "placement", "support", "player"], 
    "minecraftIds": ["minecraft:brown_mushroom", "minecraft:glass", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "player": {
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:brown_mushroom", "count": 2} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [2, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:glass"} }, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 6, "do": "interact"}, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:glass"                     }                    }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"                       }                    }, 
                {                   "is": {"id": "minecraft:brown_mushroom", "count": 2}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 7, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 7, "do": "interact"}, 
        { "at": 7, "do": "tp", "entity_alias": "player", "pos": [1.5, 5, 0.5] }, 
        {
            "at": 9, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"                       }                    }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:brown_mushroom"            }                    }, 
                {                   "is": {"id": "minecraft:brown_mushroom", "count": 1}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 10, "do": "remove", "pos": [2, 1, 0] }
    ], 
    "breakpoints": []
}

