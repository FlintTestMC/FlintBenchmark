        {"at": 6, "do": "interact"}, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [0.5, 5, 0.5] }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:stone"}                             }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:brown_mushroom"}                    }, 
                {                   "is": "empty"                           , "slot": "hotbar1" }  
