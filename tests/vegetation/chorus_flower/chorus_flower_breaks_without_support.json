                { "pos": [ 1, 1, 0], "block": {"id": "minecraft:end_stone"    } }, 
                { "pos": [ 3, 1, 0], "block": {"id": "minecraft:end_stone"    } }, 
                { "pos": [ 5, 1, 0], "block": {"id": "minecraft:end_stone"    } }, 
                { "pos": [ 9, 0, 0], "block": {"id": "minecraft:end_stone"    } }, 
                { "pos": [12, 0, 0], "block": {"id": "minecraft:stone"        } }, 
                { "pos": [ 1, 2, 0], "block": {"id": "minecraft:chorus_plant" } }, 
                { "pos": [ 3, 2, 0], "block": {"id": "minecraft:chorus_plant" } }, 
                { "pos": [ 5, 2, 0], "block": {"id": "minecraft:chorus_plant" } }, 
                { "pos": [ 6, 2, 0], "block": {"id": "minecraft:chorus_flower"} }, 
                { "pos": [ 9, 1, 0], "block": {"id": "minecraft:chorus_flower"} }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [2, 2, 0], "block": {"id": "minecraft:chorus_flower"} }, 
        { "at": 1, "do": "place", "pos": [12, 1, 0], "block": {"id": "minecraft:chorus_flower"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [6, 2, 0], "is": {"id": "minecraft:chorus_flower"} }, 
