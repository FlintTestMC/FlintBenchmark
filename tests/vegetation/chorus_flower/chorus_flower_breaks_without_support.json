            "do": "assert", 
            "checks": [
                { "pos": [ 2, 2, 0], "is": {"id": "minecraft:air"}                  }, 
                { "pos": [ 6, 2, 0], "is": {"id": "minecraft:air"}                  }, 
                { "pos": [ 9, 1, 0], "is": {"id": "minecraft:air"}                  }, 
                { "pos": [12, 1, 0], "is": {"id": "minecraft:air"}                  }, 
                {                    "is": "minecraft:item"       , "exists": false }  
            ]
        }
