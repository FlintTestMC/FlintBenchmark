{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "chorus_flower_breaks_without_support", 
    "description": "A chorus flower over air with two chorus plant neighbours, with a plant and a solid side neighbour, on stone, or after losing its end stone breaks without dropping an item.", 
    "tags": ["vegetation", "chorus-flower", "chorus-plant", "support", "neighbor-update", "drops"], 
    "minecraftIds": [
