{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "chorus_flower_destroyed_by_piston", 
    "description": "A piston pushing a chorus flower destroys it without dropping an item.", 
    "tags": ["vegetation", "chorus-flower", "piston", "push-reaction", "drops"], 
    "minecraftIds": [
        "minecraft:chorus_flower" , "minecraft:end_stone"     , "minecraft:piston"        , "minecraft:redstone_block", 
        "minecraft:item"          
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 2, 2] ]
        }, 
        "world": {
            "time": "minecraft:day", 
            "weather": "clear", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 0, 0], "block": {"id": "minecraft:end_stone"}                                     }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:chorus_flower"}                                 }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": "false"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:chorus_flower", "age": 0} }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "extended": "true"}                     }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"}                  }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"}                                            }, 
                {                   "is": "minecraft:item"                                 , "exists": false }  
            ]
        }
    ], 
    "breakpoints": []
}

