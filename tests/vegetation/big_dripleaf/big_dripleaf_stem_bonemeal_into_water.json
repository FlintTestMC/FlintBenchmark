                { "pos": [0, 2, 0], "block": {"id": "minecraft:big_dripleaf_stem", "facing": "north"} }, 
                { "pos": [0, 3, 0], "block": {"id": "minecraft:big_dripleaf_stem", "facing": "north"} }, 
                { "pos": [0, 4, 0], "block": {"id": "minecraft:big_dripleaf"     , "facing": "north"} }, 
                { "pos": [0, 5, 0], "block": {"id": "minecraft:water"                               } }  
