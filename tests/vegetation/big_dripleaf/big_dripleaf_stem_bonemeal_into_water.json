        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 2.5], "rot": [180, 0] }, 
        {"at": 5, "do": "interact"}, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 3, 0], "is": {"id": "minecraft:big_dripleaf_stem", "facing": "north"} }, 
                {
                    "pos": [0, 4, 0], 
                    "is": {"id": "minecraft:big_dripleaf_stem", "facing": "north", "waterlogged": "false"}
                }, 
                { "pos": [0, 5, 0], "is": {"id": "minecraft:big_dripleaf", "facing": "north", "waterlogged": "true"} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:bone_meal", "count": 1} }
            ]
