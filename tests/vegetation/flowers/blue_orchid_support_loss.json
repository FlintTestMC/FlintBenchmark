{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "blue_orchid_support_loss", 
    "description": "A blue orchid breaks when its soil is removed or replaced by a block that cannot support vegetation.", 
    "tags": ["vegetation", "flower", "blue_orchid", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:blue_orchid", "minecraft:dirt", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [2, 2, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"       } }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:dirt"       } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:blue_orchid"} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:blue_orchid"} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:blue_orchid"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:blue_orchid"} }  
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [0, 0, 0] }, 
        { "at": 5, "do": "place", "pos": [2, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"} }  
            ]
        }
    ], 
    "breakpoints": []
}

