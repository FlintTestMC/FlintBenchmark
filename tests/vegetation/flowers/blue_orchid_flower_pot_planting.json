{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "blue_orchid_flower_pot_planting", 
    "description": "A blue orchid planted in an empty flower pot becomes a potted blue orchid and uses up one item, while an already filled pot ignores a second orchid.", 
    "tags": ["vegetation", "flower", "blue_orchid", "flower-pot", "player"], 
    "minecraftIds": ["minecraft:blue_orchid", "minecraft:flower_pot", "minecraft:potted_blue_orchid"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:blue_orchid", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 3, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [2, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:flower_pot"        } }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:potted_blue_orchid"} }  
            ]
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:potted_blue_orchid"            }                    }, 
                {                   "is": {"id": "minecraft:blue_orchid"       , "count": 1}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [2.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 6, "do": "interact"}, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:potted_blue_orchid"            }                    }, 
                {                   "is": {"id": "minecraft:blue_orchid"       , "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

