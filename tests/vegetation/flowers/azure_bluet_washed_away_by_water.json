{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "azure_bluet_washed_away_by_water", 
    "description": "Water flowing from an adjacent source replaces an azure bluet with flowing water.", 
    "tags": ["vegetation", "flower", "azure_bluet", "fluid", "water"], 
    "minecraftIds": ["minecraft:azure_bluet", "minecraft:dirt", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [2, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [2, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [0, 1, 0], [1, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"} }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:azure_bluet"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:azure_bluet"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"        } }  
            ]
        }, 
        { "at": 3, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:water"} }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:water", "level": 0} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 1} }, 
                { "pos": [0, 0, 0], "is": {"id": "minecraft:dirt"             } }  
            ]
        }
    ], 
    "breakpoints": []
}

