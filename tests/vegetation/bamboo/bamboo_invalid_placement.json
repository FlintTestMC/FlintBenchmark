{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bamboo_invalid_placement", 
    "description": "The bamboo item cannot be placed on stone (not a bamboo-supporting block) or into a water source, and the item is not consumed.", 
    "tags": ["vegetation", "bamboo", "placement", "water", "player"], 
    "minecraftIds": [
        "minecraft:bamboo"        , "minecraft:bamboo_sapling", "minecraft:stone"         , "minecraft:dirt"          , 
        "minecraft:water"         
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, -1], [3, 5, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, -1], [3, 5, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [0, 1, 0], [3, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 1, "do": "place", "pos": [3, 1, 0], "block": {"id": "minecraft:dirt"} }, 
        { "at": 1, "do": "place", "pos": [3, 2, 0], "block": {"id": "minecraft:water"} }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:bamboo"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"   }                    }, 
                {                   "is": {"id": "minecraft:bamboo"}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [3.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact", "item": "minecraft:bamboo"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [3, 2, 0], "is": {"id": "minecraft:water" }                    }, 
                {                   "is": {"id": "minecraft:bamboo"}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

