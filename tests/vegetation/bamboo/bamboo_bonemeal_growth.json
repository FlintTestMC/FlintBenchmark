{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bamboo_bonemeal_growth", 
    "description": "One bone meal on a single bamboo stalk grows one or two new stalks on top (the first with small leaves, the second with large leaves) and consumes the item.", 
    "tags": ["vegetation", "bamboo", "bone-meal", "growth", "player"], 
    "minecraftIds": ["minecraft:bamboo", "minecraft:dirt", "minecraft:bone_meal"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 6, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 6, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [0, 1, 0], [0, 6, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:dirt"} }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [0, 2, 0], 
            "block": {"id": "minecraft:bamboo", "age": 0, "leaves": "large", "stage": 0}
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:bone_meal"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 7, 0.5] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:bamboo", "leaves": "large"} }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:bamboo", "leaves": "small", "stage": 0} }, 
                {
                    "pos": [ 0                      , 4                                                        , 0 ], 
                    "is" : [ {"id": "minecraft:air"}, {"id": "minecraft:bamboo", "leaves": "large", "stage": 0}    ]  
                }, 
                { "pos": [0, 5, 0], "is": {"id": "minecraft:air"} }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

