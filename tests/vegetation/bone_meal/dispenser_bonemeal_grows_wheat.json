{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "dispenser_bonemeal_grows_wheat", 
    "description": "A powered dispenser facing wheat at age 6 uses one bone meal from its stack of 3 to grow the wheat to age 7. The ceiling above the crop is opened so the test does not depend on an enclosed light level.", 
    "tags": ["bone-meal", "dispenser", "wheat", "redstone"], 
    "minecraftIds": [
        "minecraft:dispenser"     , "minecraft:farmland"      , "minecraft:wheat"         , "minecraft:redstone_block", 
        "minecraft:bone_meal"     
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [2, 4, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -1], [2, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-1, 1, 0], [1, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 4, 0], [0, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland"} }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:wheat", "age": 6} }, 
                {
                    "pos": [-1, 1, 0], 
                    "block": {
                        "id": "minecraft:dispenser", 
                        "facing": "east", 
                        "nbt": {"Items": "[{Slot: 0b, count: 3, id: \"minecraft:bone_meal\"}]"}
                    }
                }
            ]
        }, 
        { "at": 5, "do": "place", "pos": [-1, 2, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:wheat", "age": 7} }, 
                {
                    "pos": [-1, 1, 0], 
                    "is": {
                        "id": "minecraft:dispenser", 
                        "nbt": {"Items[0].id": "minecraft:bone_meal", "Items[0].count": 2}
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

