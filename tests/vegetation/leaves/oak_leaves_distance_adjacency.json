{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "oak_leaves_distance_adjacency", 
    "description": "Leaf distance only follows face adjacency: a diagonal leaf and a leaf behind a stone block stay at 7, while a leaf next to a crimson stem gets distance 1.", 
    "tags": ["vegetation", "leaves", "distance", "block-state", "neighbor-update"], 
    "minecraftIds": ["minecraft:oak_leaves", "minecraft:oak_log", "minecraft:crimson_stem", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [10, 3, 2] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 2, 1], "block": {"id": "minecraft:oak_leaves", "distance": 7, "persistent": false} }, 
                { "pos": [6, 1, 0], "block": {"id": "minecraft:oak_leaves", "distance": 7, "persistent": false} }, 
                { "pos": [9, 1, 0], "block": {"id": "minecraft:oak_leaves", "distance": 7, "persistent": false} }, 
                { "pos": [5, 1, 0], "block": {"id": "minecraft:stone"                                         } }  
            ]
        }, 
        {
            "at": 3, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:oak_log"     , "axis": "y"} }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:oak_log"     , "axis": "y"} }, 
                { "pos": [8, 1, 0], "block": {"id": "minecraft:crimson_stem", "axis": "y"} }  
            ]
        }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 2, 1], "is": {"id": "minecraft:oak_leaves", "distance": 7} }, 
                { "pos": [6, 1, 0], "is": {"id": "minecraft:oak_leaves", "distance": 7} }, 
                { "pos": [9, 1, 0], "is": {"id": "minecraft:oak_leaves", "distance": 1} }  
            ]
        }
    ], 
    "breakpoints": []
}

