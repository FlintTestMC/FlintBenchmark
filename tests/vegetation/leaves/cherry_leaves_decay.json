{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cherry_leaves_decay", 
    "description": "With a high random tick speed, non-persistent cherry leaves at distance 7 decay to air, while persistent cherry leaves stay.", 
    "tags": ["vegetation", "leaves", "cherry", "decay", "random-tick", "block-state"], 
    "minecraftIds": ["minecraft:cherry_leaves"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:cherry_leaves", "distance": 7, "persistent": false} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:cherry_leaves", "distance": 7, "persistent": true } }  
            ]
        }, 
        {
            "at": 60, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"                                             } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:cherry_leaves", "distance": 7, "persistent": true} }  
            ]
        }
    ], 
    "breakpoints": []
}

