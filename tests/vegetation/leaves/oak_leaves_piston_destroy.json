{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "oak_leaves_piston_destroy", 
    "description": "A piston extending into oak leaves destroys them instead of pushing them, and the piston head takes their place.", 
    "tags": ["vegetation", "leaves", "piston", "push-reaction", "redstone"], 
    "minecraftIds": ["minecraft:oak_leaves", "minecraft:piston", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": false} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:oak_leaves", "persistent": true}              }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:oak_leaves", "persistent": true}              }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"     , "facing": "east", "extended": true} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"                  } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:oak_leaves"                                     } }  
            ]
        }
    ], 
    "breakpoints": []
}

