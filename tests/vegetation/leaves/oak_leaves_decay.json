{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "oak_leaves_decay", 
    "description": "With a high random tick speed, non-persistent oak leaves at distance 7 decay to air, while persistent leaves and leaves within reach of a log stay.", 
    "tags": ["vegetation", "leaves", "decay", "random-tick", "block-state"], 
    "minecraftIds": ["minecraft:oak_leaves", "minecraft:oak_log"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:oak_leaves", "distance": 7, "persistent": false} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:oak_leaves", "distance": 7, "persistent": true}  }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:oak_leaves", "distance": 1, "persistent": false} }, 
                { "pos": [5, 1, 0], "block": {"id": "minecraft:oak_log", "axis": "y"}                           }  
            ]
        }, 
        {
            "at": 60, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"                                           } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:oak_leaves", "distance": 7, "persistent": true } }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:oak_leaves", "distance": 1, "persistent": false} }, 
                { "pos": [5, 1, 0], "is": {"id": "minecraft:oak_log"                                       } }  
            ]
        }
    ], 
    "breakpoints": []
}

