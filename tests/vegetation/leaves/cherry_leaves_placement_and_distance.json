{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cherry_leaves_placement_and_distance", 
    "description": "Cherry leaves (untinted-particle implementation) behave like other leaves on the server: survival placement is persistent with distance 7, and non-persistent leaves get their distance from an adjacent log.", 
    "tags": ["vegetation", "leaves", "cherry", "placement", "distance", "block-state", "player"], 
    "minecraftIds": ["minecraft:cherry_leaves", "minecraft:oak_log", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [6, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:cherry_leaves", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                                            } }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:cherry_leaves", "distance": 7, "persistent": false} }, 
                { "pos": [5, 1, 0], "block": {"id": "minecraft:cherry_leaves", "distance": 7, "persistent": false} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 3, "do": "place", "pos": [3, 1, 0], "block": {"id": "minecraft:oak_log", "axis": "y"} }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:cherry_leaves", "distance": 7, "persistent": true, "waterlogged": false}
                }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:cherry_leaves", "distance": 1, "persistent": false} }, 
                { "pos": [5, 1, 0], "is": {"id": "minecraft:cherry_leaves", "distance": 2, "persistent": false} }, 
                {"is": "empty", "slot": "hotbar1"}
            ]
        }
    ], 
    "breakpoints": []
}

