{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "brown_mushroom_block_face_stays_hidden_after_removal", 
    "description": "Removing an adjacent brown mushroom block does not turn the remaining block's hidden face back on. The newly placed block starts with its west face hidden, matching the state the server's mutual neighbour updates give it.", 
    "tags": ["vegetation", "mushroom", "block-state", "huge-mushroom", "neighbor-update", "removal"], 
    "minecraftIds": ["minecraft:brown_mushroom_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 0, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 0, 0], 
            "block": {
                "id": "minecraft:brown_mushroom_block", 
                "up": true, 
                "down": true, 
                "north": true, 
                "east": true, 
                "south": true, 
                "west": true
            }
        }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [1, 0, 0], 
            "block": {
                "id": "minecraft:brown_mushroom_block", 
                "up": true, 
                "down": true, 
                "north": true, 
                "east": true, 
                "south": true, 
                "west": false
            }
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id": "minecraft:brown_mushroom_block", 
                        "up": true, 
                        "down": true, 
                        "north": true, 
                        "east": false, 
                        "south": true, 
                        "west": true
                    }
                }
            ]
        }, 
        { "at": 2, "do": "remove", "pos": [1, 0, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 0, 0], "is": {"id": "minecraft:air"} }, 
                {
                    "pos": [0, 0, 0], 
                    "is": {
                        "id": "minecraft:brown_mushroom_block", 
                        "up": true, 
                        "down": true, 
                        "north": true, 
                        "east": false, 
                        "south": true, 
                        "west": true
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

