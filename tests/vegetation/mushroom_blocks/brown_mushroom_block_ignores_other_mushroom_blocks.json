{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "brown_mushroom_block_ignores_other_mushroom_blocks", 
    "description": "Red mushroom blocks and mushroom stems next to a brown mushroom block, placed by the player or by the place action, leave all of the brown block's faces true.", 
    "tags": ["vegetation", "mushroom", "block-state", "huge-mushroom", "placement", "neighbor-update", "player"], 
    "minecraftIds": ["minecraft:brown_mushroom_block", "minecraft:red_mushroom_block", "minecraft:mushroom_stem"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [5, 2, 0] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:red_mushroom_block"} }, 
        { "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90], "at": 1 }, 
        {"at": 1, "do": "interact", "item": "minecraft:brown_mushroom_block"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:brown_mushroom_block", 
                        "up": true, 
                        "down": true, 
                        "north": true, 
                        "east": true, 
                        "south": true, 
                        "west": true
                    }
                }
            ]
        }, 
        {
            "at": 2, 
            "do": "place", 
            "pos": [4, 1, 0], 
            "block": {
                "id": "minecraft:brown_mushroom_block", 
                "up": true, 
                "down": true, 
                "north": true, 
                "east": true, 
                "south": true, 
                "west": true
            }
        }, 
        { "at": 3, "do": "place", "pos": [4, 2, 0], "block": {"id": "minecraft:red_mushroom_block"} }, 
        { "at": 3, "do": "place", "pos": [5, 1, 0], "block": {"id": "minecraft:mushroom_stem"} }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [4, 1, 0], 
                    "is": {
                        "id": "minecraft:brown_mushroom_block", 
                        "up": true, 
                        "down": true, 
                        "north": true, 
                        "east": true, 
                        "south": true, 
                        "west": true
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

