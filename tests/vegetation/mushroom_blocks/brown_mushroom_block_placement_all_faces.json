{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "brown_mushroom_block_placement_all_faces", 
    "description": "A player placing a brown mushroom block against a non-mushroom block gets all six faces set to true.", 
    "tags": ["vegetation", "mushroom", "block-state", "huge-mushroom", "placement", "player"], 
    "minecraftIds": ["minecraft:brown_mushroom_block", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90], "at": 1 }, 
        {"at": 1, "do": "interact", "item": "minecraft:brown_mushroom_block"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:brown_mushroom_block", 
                        "up": true, 
                        "down": true, 
                        "north": true, 
                        "east": true, 
                        "south": true, 
                        "west": true
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

