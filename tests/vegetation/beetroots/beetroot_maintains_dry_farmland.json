{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "beetroot_maintains_dry_farmland", 
    "description": "At the default random tick speed, dry farmland with no water nearby stays farmland under beetroots but turns to dirt when nothing is planted on it.", 
    "tags": ["vegetation", "crop", "beetroots", "farmland", "random-tick"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:dirt", "minecraft:beetroots"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [2, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland"           } }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:farmland"           } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:beetroots", "age": 3} }  
            ]
        }, 
        {
            "at": [2000, 4000, 6000, 8000, 10000, 12000, 14000, 16000, 18000], 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland"           } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:beetroots", "age": 3} }  
            ]
        }, 
        {
            "at": 20000, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland"           } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:beetroots", "age": 3} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:dirt"               } }  
            ]
        }
    ], 
    "breakpoints": []
}

