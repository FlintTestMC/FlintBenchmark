{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "beetroot_support_loss", 
    "description": "Beetroots of any age break into air when the farmland beneath them is removed, while neighbouring beetroots on intact farmland stay.", 
    "tags": ["vegetation", "crop", "beetroots", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:beetroots"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [4, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland"           } }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:farmland"           } }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:farmland"           } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:beetroots", "age": 0} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:beetroots", "age": 3} }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:beetroots", "age": 3} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:beetroots", "age": 0} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:beetroots", "age": 3} }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:beetroots", "age": 3} }  
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [0, 0, 0] }, 
        { "at": 5, "do": "remove", "pos": [2, 0, 0] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"                } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"                } }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:air"                } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"                } }, 
                { "pos": [4, 0, 0], "is": {"id": "minecraft:farmland"           } }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:beetroots", "age": 3} }  
            ]
        }
    ], 
    "breakpoints": []
}

