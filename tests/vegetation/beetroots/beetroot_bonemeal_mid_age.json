{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "beetroot_bonemeal_mid_age", 
    "description": "Bone meal fired by a dispenser (not a player interaction) at age-two beetroots leaves them at age two or three and is consumed. The player-interaction path for bone meal on age-two beetroots is not tested here.", 
    "tags": ["vegetation", "crop", "beetroots", "bone-meal", "dispenser"], 
    "minecraftIds": [
        "minecraft:farmland"      , "minecraft:beetroots"     , "minecraft:bone_meal"     , "minecraft:dispenser"     , 
        "minecraft:redstone_block"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [0, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland"} }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:beetroots", "age": 2} }, 
                {
                    "pos": [-1, 1, 0], 
                    "block": {
                        "id": "minecraft:dispenser", 
                        "facing": "east", 
                        "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:bone_meal\"}]"}
                    }
                }
            ]
        }, 
        { "at": 6, "do": "place", "pos": [-1, 2, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 20, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [-1, 1, 0], 
                    "is": { "id": "minecraft:dispenser", "nbt": {"Items": []} }
                }, 
                {
                    "pos": [ 0                                      , 1                                      , 0 ], 
                    "is" : [ {"id": "minecraft:beetroots", "age": 2}, {"id": "minecraft:beetroots", "age": 3}    ]  
                }
            ]
        }
    ], 
    "breakpoints": []
}

