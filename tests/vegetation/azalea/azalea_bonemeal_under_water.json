{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "azalea_bonemeal_under_water", 
    "description": "Bone meal used on the side of an azalea with water directly above is not a valid tree target: no tree grows, the azalea stays and the bone meal is not consumed.", 
    "tags": ["vegetation", "azalea", "bone-meal", "water", "player"], 
    "minecraftIds": ["minecraft:azalea", "minecraft:dirt", "minecraft:bone_meal", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
