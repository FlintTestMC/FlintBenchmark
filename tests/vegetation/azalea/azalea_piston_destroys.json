{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "azalea_piston_destroys", 
    "description": "Fallback for breaking an azalea (Flint has no break-block action): a piston pushing into an azalea destroys it because its push reaction is DESTROY, leaving the piston head in its place.", 
    "tags": ["vegetation", "azalea", "piston", "push-reaction"], 
    "minecraftIds": ["minecraft:azalea", "minecraft:dirt", "minecraft:piston", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, -1], [3, 4, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [0, 1, 0], [3, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 1, "do": "place", "pos": [2, 0, 0], "block": {"id": "minecraft:dirt"} }, 
        { "at": 1, "do": "place", "pos": [2, 1, 0], "block": {"id": "minecraft:azalea"} }, 
        { "at": 1, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:piston", "facing": "east"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:azalea"                     } }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston", "extended": "false"} }  
            ]
        }, 
        { "at": 3, "do": "place", "pos": [1, 2, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston"     , "extended": "true"                  } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:piston_head",                     "facing": "east"} }  
            ]
        }
    ], 
    "breakpoints": []
}

