{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "brain_coral_piston_push", 
    "description": "A piston extending into a brain coral destroys it (push reaction destroy) instead of pushing it, and the piston head takes its place.", 
    "tags": ["vegetation", "coral", "piston", "push-reaction"], 
    "minecraftIds": [
        "minecraft:brain_coral"   , "minecraft:piston"        , "minecraft:piston_head"   , "minecraft:redstone_block", 
        "minecraft:stone"         
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [-1, 1, 0], 
            "block": {"id": "minecraft:piston", "facing": "east", "extended": false}
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:brain_coral", "waterlogged": false} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:brain_coral", "waterlogged": false} }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [-1, 2, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:piston"     , "facing": "east", "extended": true} }, 
                { "pos": [ 0, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"                  } }, 
                { "pos": [ 1, 1, 0], "is": {"id": "minecraft:air"                                            } }  
            ]
        }
    ], 
    "breakpoints": []
}

