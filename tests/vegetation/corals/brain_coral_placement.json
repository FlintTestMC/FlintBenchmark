{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "brain_coral_placement", 
    "description": "A brain coral placed in a water source is waterlogged, placed in air is not, and it cannot be placed on the top of a bottom slab because that face is not sturdy.", 
    "tags": ["vegetation", "coral", "placement", "waterlogged", "player"], 
    "minecraftIds": ["minecraft:brain_coral", "minecraft:stone", "minecraft:water", "minecraft:stone_slab"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [9, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:brain_coral", "count": 3} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [9, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:water"} }, 
        { "at": 0, "do": "remove", "pos": [4, 1, 0] }, 
        { "at": 0, "do": "place", "pos": [8, 0, 0], "block": {"id": "minecraft:stone_slab", "type": "bottom"} }, 
        { "at": 0, "do": "remove", "pos": [8, 1, 0] }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [4.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [8.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:brain_coral", "waterlogged": true}                     }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:brain_coral", "waterlogged": false}                    }, 
                { "pos": [8, 1, 0], "is": {"id": "minecraft:air"}                                                  }, 
                {                   "is": {"id": "minecraft:brain_coral", "count": 1}          , "slot": "hotbar1" }  
            ]
        }
    ], 
