{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "chorus_plant_side_support", 
    "description": "A chorus plant can be held up by a supported neighbouring plant, but breaks when a block is placed above it, and a plant on end stone also breaks when a block above it meets a plant neighbour.", 
    "tags": ["vegetation", "chorus-plant", "support", "neighbor-update", "block-state"], 
    "minecraftIds": ["minecraft:chorus_plant", "minecraft:end_stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [7, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [7, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [7, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:end_stone"} }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:end_stone"} }, 
                { "pos": [5, 0, 0], "block": {"id": "minecraft:end_stone"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:chorus_plant"} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:chorus_plant"} }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:chorus_plant"} }, 
                { "pos": [5, 1, 0], "block": {"id": "minecraft:chorus_plant"} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:chorus_plant", "down": true, "east": true, "west": false}
                }, 
                {
                    "pos": [1, 1, 0], 
                    "is": {"id": "minecraft:chorus_plant", "down": false, "west": true, "east": false}
                }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:chorus_plant", "down": true, "east": true} }, 
                { "pos": [5, 1, 0], "is": {"id": "minecraft:chorus_plant", "down": true, "west": true} }
            ]
        }, 
        {
            "at": 6, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 2, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [4, 2, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        {
            "at": 9, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"}                                       }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:chorus_plant", "down": true, "east": false} }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:air"}                                       }, 
                { "pos": [5, 1, 0], "is": {"id": "minecraft:chorus_plant", "down": true, "west": false} }  
            ]
        }
    ], 
    "breakpoints": []
}

