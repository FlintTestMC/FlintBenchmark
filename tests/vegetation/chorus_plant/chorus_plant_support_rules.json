{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "chorus_plant_support_rules", 
    "description": "A chorus plant survives on end stone, breaks one tick later on other blocks or on a chorus flower, and does not connect sideways to end stone.", 
    "tags": ["vegetation", "chorus-plant", "support", "block-state", "neighbor-update"], 
    "minecraftIds": ["minecraft:chorus_plant", "minecraft:end_stone", "minecraft:chorus_flower"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [8, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [8, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [8, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:end_stone"    } }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:end_stone"    } }, 
                { "pos": [3, 1, 0], "block": {"id": "minecraft:end_stone"    } }, 
                { "pos": [5, 1, 0], "block": {"id": "minecraft:end_stone"    } }, 
                { "pos": [7, 0, 0], "block": {"id": "minecraft:end_stone"    } }, 
                { "pos": [7, 1, 0], "block": {"id": "minecraft:chorus_flower"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:chorus_plant"} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:chorus_plant"} }, 
                { "pos": [4, 1, 0], "block": {"id": "minecraft:chorus_plant"} }, 
                { "pos": [7, 2, 0], "block": {"id": "minecraft:chorus_plant"} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:chorus_plant", 
                        "down": true, 
                        "up": false, 
                        "north": false, 
                        "east": false, 
                        "south": false, 
                        "west": false
                    }
                }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"} }, 
                {
                    "pos": [4, 1, 0], 
                    "is": {
                        "id": "minecraft:chorus_plant", 
                        "down": true, 
                        "up": false, 
                        "north": false, 
                        "east": false, 
                        "south": false, 
                        "west": false
                    }
                }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:end_stone"} }, 
                { "pos": [5, 1, 0], "is": {"id": "minecraft:end_stone"} }, 
                { "pos": [7, 2, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [7, 1, 0], "is": {"id": "minecraft:chorus_flower"} }
            ]
        }
    ], 
    "breakpoints": []
}

