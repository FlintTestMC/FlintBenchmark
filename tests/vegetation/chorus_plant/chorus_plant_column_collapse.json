{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "chorus_plant_column_collapse", 
    "description": "Removing the end stone under a three-block chorus plant column breaks the whole column from the bottom up.", 
    "tags": ["vegetation", "chorus-plant", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:chorus_plant", "minecraft:end_stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [1, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:end_stone"} }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:chorus_plant"} }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:chorus_plant"} }, 
                { "pos": [0, 3, 0], "block": {"id": "minecraft:chorus_plant"} }  
            ]
        }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:chorus_plant", "down": true, "up": true } }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:chorus_plant", "down": true, "up": true } }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:chorus_plant", "down": true, "up": false} }  
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:air"} }  
            ]
        }
    ], 
    "breakpoints": []
}

