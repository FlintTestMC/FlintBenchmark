{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cave_vines_harvest_berries", 
    "description": "Using an empty hand on a cave vines tip with berries clears the berries and drops one glow berries; a tip without berries is unchanged and drops nothing.", 
    "tags": ["vegetation", "cave-vines", "berries", "harvest", "drops", "player"], 
    "minecraftIds": ["minecraft:cave_vines", "minecraft:glow_berries", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 4, 3] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 4, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [4, 2, 3] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 2, 0], "block": {"id": "minecraft:cave_vines", "age": 4, "berries": true } }, 
                { "pos": [4, 2, 0], "block": {"id": "minecraft:cave_vines", "age": 4, "berries": false} }  
            ]
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 2.5], "rot": [180, 0] }, 
        {"at": 5, "do": "interact"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:cave_vines", "age": 4, "berries": false} } , 
                { "is": "minecraft:item", "count": 1, "pos": [0.5, 2, 0.5], "position_tolerance": 2.5 }  
            ]
        }, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [4.5, 1, 2.5], "rot": [180, 0] }, 
        {"at": 6, "do": "interact"}, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [4, 2, 0], "is": {"id": "minecraft:cave_vines", "age": 4, "berries": false}             }, 
                {                   "is": "minecraft:item"                                          , "count": 1 }  
            ]
        }
    ], 
    "breakpoints": []
}

