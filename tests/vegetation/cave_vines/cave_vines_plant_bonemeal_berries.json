        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [4.5, 2, 2.5], "rot": [180, 0] }, 
        {"at": 6, "do": "interact"}, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [4, 3, 0], "is": {"id": "minecraft:cave_vines_plant", "berries": false} }    , 
                { "pos": [4, 2, 0], "is": {"id": "minecraft:cave_vines", "age": 4, "berries": false} }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:air"} }                                   , 
                { "slot": "hotbar1", "is": {"id": "minecraft:bone_meal", "count": 1} }                  
