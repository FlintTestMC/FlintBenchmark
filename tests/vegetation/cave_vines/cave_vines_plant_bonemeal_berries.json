{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cave_vines_plant_bonemeal_berries", 
    "description": "Bone meal gives a berry-less cave vines plant berries without growing the vine; on a plant that already has berries the click harvests them and the bone meal is kept.", 
    "tags": ["vegetation", "cave-vines", "cave-vines-plant", "bone-meal", "berries", "player"], 
