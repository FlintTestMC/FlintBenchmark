{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cave_vines_placement_under_block", 
    "description": "Glow berries used on the underside of a block place a berry-less cave vines tip and consume one item.", 
    "tags": ["vegetation", "cave-vines", "placement", "player"], 
    "minecraftIds": ["minecraft:cave_vines", "minecraft:glow_berries", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
