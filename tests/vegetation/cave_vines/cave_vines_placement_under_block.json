    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 0, 0], [0, 2, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, -90] }, 
        {"at": 5, "do": "interact"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:cave_vines", "berries": false}                    }, 
                {                   "is": {"id": "minecraft:glow_berries", "count": 1}    , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

