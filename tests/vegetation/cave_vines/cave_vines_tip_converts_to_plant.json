{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cave_vines_tip_converts_to_plant", 
    "description": "A cave vines tip with another vine placed directly below it becomes a cave vines plant that keeps its berries, whether the lower vine is set directly or placed from glow berries.", 
    "tags": ["vegetation", "cave-vines", "cave-vines-plant", "placement", "neighbor-update", "player"], 
    "minecraftIds": [
        "minecraft:cave_vines"      , "minecraft:cave_vines_plant", "minecraft:glow_berries"    , 
        "minecraft:stone"           
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 4, 3] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:glow_berries", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 4, 3] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 0, 0], [4, 3, 3] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place", 
            "pos": [0, 3, 0], 
            "block": {"id": "minecraft:cave_vines", "age": 3, "berries": true}
        }, 
        {
            "at": 4, 
            "do": "place", 
            "pos": [4, 3, 0], 
            "block": {"id": "minecraft:cave_vines", "age": 3, "berries": false}
        }, 
        {
            "at": 5, 
            "do": "place", 
            "pos": [0, 2, 0], 
            "block": {"id": "minecraft:cave_vines", "age": 4, "berries": false}
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [4.5, 0, 0.5], "rot": [0, -90] }, 
        {"at": 5, "do": "interact"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 3, 0], "is": {"id": "minecraft:cave_vines_plant", "berries": true}                     }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:cave_vines", "berries": false}                          }, 
                { "pos": [4, 3, 0], "is": {"id": "minecraft:cave_vines_plant", "berries": false}                    }, 
                { "pos": [4, 2, 0], "is": {"id": "minecraft:cave_vines", "berries": false}                          }, 
                {                   "is": {"id": "minecraft:glow_berries", "count": 1}          , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

