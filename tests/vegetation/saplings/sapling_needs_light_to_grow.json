{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "sapling_needs_light_to_grow", 
    "description": "With rapid random ticks a sapling in a sealed dark cavity stays at stage 0, while a sapling open to the sky advances to stage 1 or grows into a tree. Uses the minecraft:random_tick_speed gamerule set to 1024 (default 3) and waits 400 ticks to speed up growth.", 
    "tags": ["vegetation", "sapling", "growth", "random-tick", "light"], 
    "minecraftIds": ["minecraft:oak_sapling", "minecraft:dirt", "minecraft:oak_log"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [11, 14, 8] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 1024
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [11, 14, 8] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [0, 2, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [3, 1, 1], [9, 14, 7] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"                   } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:oak_sapling", "stage": 0} }, 
                { "pos": [6, 0, 4], "block": {"id": "minecraft:dirt"                   } }, 
                { "pos": [6, 1, 4], "block": {"id": "minecraft:oak_sapling", "stage": 0} }  
            ]
        }, 
        {
            "at": 400, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_sapling", "stage": 0} }, 
                {
                    "pos": [6, 1, 4]                                                                                , 
                    "is" : [ {"id": "minecraft:oak_sapling", "stage": 1}, {"id": "minecraft:oak_log", "axis": "y"} ]  
                }
            ]
        }
    ], 
    "breakpoints": []
}

