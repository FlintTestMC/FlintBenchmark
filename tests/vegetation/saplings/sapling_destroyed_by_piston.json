{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "sapling_destroyed_by_piston", 
    "description": "A piston that extends into a sapling destroys it instead of pushing it.", 
    "tags": ["vegetation", "sapling", "piston", "push-reaction"], 
    "minecraftIds": [
        "minecraft:oak_sapling"   , "minecraft:dirt"          , "minecraft:piston"        , "minecraft:piston_head"   , 
        "minecraft:redstone_block"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [3, 4, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 1, 0], [3, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 0, 0], "block": {"id": "minecraft:dirt"}                                        }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:oak_sapling", "stage": 0}                     }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": false} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:oak_sapling", "stage": 0}                     }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": false} }  
            ]
        }, 
        { "at": 6, "do": "place", "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"                  } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"     , "facing": "east", "extended": true} }  
            ]
        }
    ], 
    "breakpoints": []
}

