{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bamboo_sapling_breaks_without_support", 
    "description": "A bamboo sapling turns into air when the dirt beneath it is replaced by stone, cobblestone, glass or planks, or removed entirely.", 
    "tags": ["vegetation", "bamboo", "bamboo-sapling", "support", "neighbor-update"], 
    "minecraftIds": [
        "minecraft:bamboo_sapling", "minecraft:dirt"          , "minecraft:stone"         , "minecraft:cobblestone"   , 
        "minecraft:glass"         , "minecraft:oak_planks"    
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [5, 5, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [5, 5, 2] ], 
