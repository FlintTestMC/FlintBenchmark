{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "sapling_survives_on_valid_ground", 
    "description": "Saplings stay in place after a neighbor update when the block below is grass, dirt, podzol, coarse dirt, rooted dirt, mud, moss block or farmland.", 
    "tags": ["vegetation", "sapling", "support", "neighbor-update"], 
    "minecraftIds": [
        "minecraft:oak_sapling", "minecraft:grass_block", "minecraft:dirt"       , "minecraft:podzol"     , 
