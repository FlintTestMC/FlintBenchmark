{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "sapling_grows_into_acacia_tree", 
    "description": "With rapid random ticks an acacia sapling in open light grows into an acacia tree whose trunk starts where the sapling stood. Uses the minecraft:random_tick_speed gamerule set to 1024 (default 3) and waits 400 ticks to speed up growth.", 
    "tags": ["vegetation", "sapling", "growth", "random-tick", "tree", "acacia"], 
    "minecraftIds": ["minecraft:acacia_sapling", "minecraft:dirt", "minecraft:acacia_log"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-7, 0, -7], [7, 16, 7] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 1024
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-7, 0, -7], [7, 16, 7] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-6, 1, -6], [6, 16, 6] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"                      } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:acacia_sapling", "stage": 0} }  
            ]
        }, 
        {
            "at": 400, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:acacia_log"} }
            ]
        }
    ], 
    "breakpoints": []
}

