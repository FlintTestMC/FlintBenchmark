{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "sapling_grows_into_oak_tree", 
    "description": "With rapid random ticks an oak sapling in open light advances to stage 1 and then grows into an oak tree whose trunk starts where the sapling stood. Uses the minecraft:random_tick_speed gamerule set to 1024 (default 3) and waits 400 ticks to speed up growth.", 
    "tags": ["vegetation", "sapling", "growth", "random-tick", "tree", "oak"], 
    "minecraftIds": ["minecraft:oak_sapling", "minecraft:dirt", "minecraft:oak_log"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-5, 0, -5], [5, 14, 5] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 1024
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-5, 0, -5], [5, 14, 5] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-4, 1, -4], [4, 14, 4] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:dirt"                   } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:oak_sapling", "stage": 0} }  
            ]
        }, 
        {
            "at": 400, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_log", "axis": "y"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:oak_log", "axis": "y"} }  
            ]
        }
    ], 
    "breakpoints": []
}

