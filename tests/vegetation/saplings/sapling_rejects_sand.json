{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "sapling_rejects_sand", 
    "description": "A sapling item used on sand places nothing and the item is kept.", 
    "tags": ["vegetation", "sapling", "placement", "player"], 
    "minecraftIds": ["minecraft:oak_sapling", "minecraft:sand"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 5, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 5, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [0, 2, 0], [0, 4, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 4, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:sand"} }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact", "item": "minecraft:oak_sapling"}, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 5, 0.5] }, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"                    }                    }, 
                {                   "is": {"id": "minecraft:oak_sapling", "count": 1}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

