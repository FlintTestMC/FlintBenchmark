{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bush_bonemeal_no_valid_neighbour", 
    "description": "Bone meal on a bush with no empty supported horizontal neighbour places nothing, not even above, and is not consumed.", 
