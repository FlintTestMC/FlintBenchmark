            "region": [ [-2, -1, -2], [2, 4, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [1, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
