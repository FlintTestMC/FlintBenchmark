    "minecraftIds": [
        "minecraft:bush"       , "minecraft:grass_block", "minecraft:dirt"       , "minecraft:sand"       , 
        "minecraft:bone_meal"  
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, -1, -2], [2, 4, 2] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:bone_meal", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
