{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "attached_melon_stem_rejects_bonemeal", 
    "description": "Bone meal does not affect an attached melon stem and is not consumed.", 
    "tags": ["vegetation", "stem", "attached-stem", "melon", "bone-meal", "player"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:melon", "minecraft:attached_melon_stem", "minecraft:bone_meal"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [2, 4, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -1], [2, 4, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-1, 1, 0], [1, 3, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 0, 0], "block": {"id": "minecraft:farmland"                             } }, 
                { "pos": [ 0, 1, 0], "block": {"id": "minecraft:melon"                                } }, 
                { "pos": [-1, 1, 0], "block": {"id": "minecraft:attached_melon_stem", "facing": "east"} }  
            ]
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [-0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact", "item": "minecraft:bone_meal"}, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [-0.5, 5, 0.5] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:attached_melon_stem", "facing": "east"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:melon"} }                                 , 
                { "is": {"id": "minecraft:bone_meal", "count": 1}, "slot": "hotbar1" }                  
            ]
        }
    ], 
    "breakpoints": []
}

