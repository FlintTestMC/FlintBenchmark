{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "attached_stem_keeps_matching_fruit", 
    "description": "Attached pumpkin and melon stems keep their family and facing when their matching fruit remains present during an unrelated neighbor update.", 
    "tags": ["vegetation", "stem", "attached-stem", "pumpkin", "melon", "neighbor-update"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:attached_pumpkin_stem", "minecraft:attached_melon_stem"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, -1], [3, 1, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland"                               } }, 
                { "pos": [3, 0, 0], "block": {"id": "minecraft:farmland"                               } }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:pumpkin"                                } }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:melon"                                  } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:attached_pumpkin_stem", "facing": "east"} }, 
                { "pos": [3, 1, 0], "block": {"id": "minecraft:attached_melon_stem"  , "facing": "west"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:attached_pumpkin_stem", "facing": "east"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:pumpkin"                                } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:melon"                                  } }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:attached_melon_stem"  , "facing": "west"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, -1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [3, 1, -1], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:attached_pumpkin_stem", "facing": "east"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:pumpkin"                                } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:melon"                                  } }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:attached_melon_stem"  , "facing": "west"} }  
            ]
        }
    ], 
    "breakpoints": []
}

