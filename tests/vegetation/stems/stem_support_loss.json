            "region": [ [0, 1, 0], [10, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 0, 0], "block": {"id": "minecraft:farmland"                                         } }, 
                { "pos": [ 3, 0, 0], "block": {"id": "minecraft:farmland"                                         } }, 
                { "pos": [ 6, 0, 0], "block": {"id": "minecraft:farmland"                                         } }, 
                { "pos": [ 9, 0, 0], "block": {"id": "minecraft:farmland"                                         } }, 
                { "pos": [ 4, 0, 0], "block": {"id": "minecraft:dirt"                                             } }, 
                { "pos": [10, 0, 0], "block": {"id": "minecraft:dirt"                                             } }, 
                { "pos": [ 4, 1, 0], "block": {"id": "minecraft:pumpkin"                                          } }, 
                { "pos": [10, 1, 0], "block": {"id": "minecraft:melon"                                            } }, 
                { "pos": [ 0, 1, 0], "block": {"id": "minecraft:pumpkin_stem"         , "age": 3                  } }, 
                { "pos": [ 3, 1, 0], "block": {"id": "minecraft:attached_pumpkin_stem",           "facing": "east"} }, 
                { "pos": [ 6, 1, 0], "block": {"id": "minecraft:melon_stem"           , "age": 4                  } }, 
                { "pos": [ 9, 1, 0], "block": {"id": "minecraft:attached_melon_stem"  ,           "facing": "east"} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:pumpkin_stem"         , "age": 3                  } }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:attached_pumpkin_stem",           "facing": "east"} }, 
                { "pos": [6, 1, 0], "is": {"id": "minecraft:melon_stem"           , "age": 4                  } }, 
                { "pos": [9, 1, 0], "is": {"id": "minecraft:attached_melon_stem"  ,           "facing": "east"} }  
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [0, 0, 0] }, 
        { "at": 5, "do": "remove", "pos": [3, 0, 0] }, 
        { "at": 5, "do": "remove", "pos": [6, 0, 0] }, 
        { "at": 5, "do": "remove", "pos": [9, 0, 0] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [ 0, 0, 0], "is": {"id": "minecraft:air"    } }, 
                { "pos": [ 0, 1, 0], "is": {"id": "minecraft:air"    } }, 
                { "pos": [ 3, 0, 0], "is": {"id": "minecraft:air"    } }, 
                { "pos": [ 3, 1, 0], "is": {"id": "minecraft:air"    } }, 
                { "pos": [ 4, 1, 0], "is": {"id": "minecraft:pumpkin"} }, 
                { "pos": [ 6, 0, 0], "is": {"id": "minecraft:air"    } }, 
                { "pos": [ 6, 1, 0], "is": {"id": "minecraft:air"    } }, 
                { "pos": [ 9, 0, 0], "is": {"id": "minecraft:air"    } }, 
                { "pos": [ 9, 1, 0], "is": {"id": "minecraft:air"    } }, 
                { "pos": [10, 1, 0], "is": {"id": "minecraft:melon"  } }  
