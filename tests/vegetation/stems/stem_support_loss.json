{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "stem_support_loss", 
    "description": "Normal and attached pumpkin and melon stems break when the farmland beneath them is removed, while their fruits remain.", 
    "tags": ["vegetation", "stem", "attached-stem", "pumpkin", "melon", "support", "neighbor-update"], 
    "minecraftIds": [
        "minecraft:farmland"             , "minecraft:pumpkin_stem"         , "minecraft:melon_stem"           , 
