{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "attached_stem_destroyed_by_piston", 
    "description": "A piston extending into an attached pumpkin stem destroys it and the piston head takes its place, while the pumpkin beside it remains.", 
    "tags": ["vegetation", "stem", "attached-stem", "pumpkin", "piston", "push-reaction"], 
    "minecraftIds": [
        "minecraft:farmland"             , "minecraft:pumpkin"              , "minecraft:piston"               , 
        "minecraft:redstone_block"       , "minecraft:piston_head"          , "minecraft:attached_pumpkin_stem"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -2], [2, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -2], [2, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [1, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0] , "block": {"id": "minecraft:farmland"}                                       }, 
                { "pos": [1, 1, 0] , "block": {"id": "minecraft:pumpkin"}                                        }, 
                { "pos": [0, 1, 0] , "block": {"id": "minecraft:attached_pumpkin_stem", "facing": "east"}        }, 
                { "pos": [0, 1, -1], "block": {"id": "minecraft:piston", "facing": "south", "extended": "false"} }  
            ]
        }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0] , "is": {"id": "minecraft:attached_pumpkin_stem", "facing": "east"} }, 
                { "pos": [0, 1, -1], "is": {"id": "minecraft:piston", "extended": "false"}             }  
            ]
        }, 
        { "at": 5, "do": "place", "pos": [-1, 1, -1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 15, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1,  0], "is": {"id": "minecraft:piston_head", "facing": "south"                    } }, 
                { "pos": [0, 1, -1], "is": {"id": "minecraft:piston"     ,                    "extended": "true"} }, 
                { "pos": [1, 1,  0], "is": {"id": "minecraft:pumpkin"                                           } }  
            ]
        }
    ], 
    "breakpoints": []
}

