            "checks": [
                { "pos": [0, 1, -1], "is": {"id": "minecraft:brain_coral_wall_fan", "facing": "south"} }, 
                { "pos": [0, 1, 0] , "is": {"id": "minecraft:piston", "extended": false}               }  
            ]
        }, 
        { "at": 3, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
