{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cocoa_support_loss", 
    "description": "Cocoa breaks when the log it faces is removed or replaced with a block that is not a jungle log or wood.", 
    "tags": ["vegetation", "cocoa", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:cocoa", "minecraft:jungle_log", "minecraft:oak_log"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -2], [4, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -2], [4, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 2,  0], "block": {"id": "minecraft:jungle_log"                             } }, 
                { "pos": [3, 2,  0], "block": {"id": "minecraft:jungle_log"                             } }, 
                { "pos": [0, 2, -1], "block": {"id": "minecraft:cocoa"     , "age": 1, "facing": "south"} }, 
                { "pos": [3, 2, -1], "block": {"id": "minecraft:cocoa"     , "age": 2, "facing": "south"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, -1], "is": {"id": "minecraft:cocoa", "age": 1, "facing": "south"} }, 
                { "pos": [3, 2, -1], "is": {"id": "minecraft:cocoa", "age": 2, "facing": "south"} }  
            ]
        }, 
        { "at": 2, "do": "remove", "pos": [0, 2, 0] }, 
        { "at": 2, "do": "place", "pos": [3, 2, 0], "block": {"id": "minecraft:oak_log"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2,  0], "is": {"id": "minecraft:air"    } }, 
                { "pos": [0, 2, -1], "is": {"id": "minecraft:air"    } }, 
                { "pos": [3, 2,  0], "is": {"id": "minecraft:oak_log"} }, 
                { "pos": [3, 2, -1], "is": {"id": "minecraft:air"    } }  
            ]
        }
    ], 
    "breakpoints": []
}

