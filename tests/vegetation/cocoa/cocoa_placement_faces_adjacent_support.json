{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cocoa_placement_faces_adjacent_support", 
    "description": "Cocoa beans used on top of a block place cocoa facing whichever horizontal neighbour is a jungle log, skipping unsupported directions.", 
    "tags": ["vegetation", "cocoa", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:cocoa", "minecraft:cocoa_beans", "minecraft:jungle_log", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -2], [5, 5, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:cocoa_beans", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -2], [5, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 2,  0], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [1, 3,  0], "block": {"id": "minecraft:jungle_log"} }, 
                { "pos": [4, 2,  0], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [4, 3, -1], "block": {"id": "minecraft:jungle_log"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [4.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 3, 0], "is": {"id": "minecraft:cocoa", "age": 0, "facing": "east"}                     }, 
                { "pos": [4, 3, 0], "is": {"id": "minecraft:cocoa", "age": 0, "facing": "north"}                    }, 
                {                   "is": "empty"                                               , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

