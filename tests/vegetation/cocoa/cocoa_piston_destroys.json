{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cocoa_piston_destroys", 
    "description": "An extending piston destroys cocoa in its path instead of pushing it, leaving the piston head in its place.", 
    "tags": ["vegetation", "cocoa", "piston", "push-reaction"], 
    "minecraftIds": [
        "minecraft:cocoa"         , "minecraft:jungle_log"    , "minecraft:piston"        , "minecraft:piston_head"   , 
        "minecraft:redstone_block"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -1], [2, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -1], [2, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 1, 2, 0], "block": {"id": "minecraft:jungle_log"                            } }, 
                { "pos": [ 0, 2, 0], "block": {"id": "minecraft:cocoa"     , "age": 2, "facing": "east"} }, 
                { "pos": [-1, 2, 0], "block": {"id": "minecraft:piston"    ,           "facing": "east"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [ 0, 2, 0], "is": {"id": "minecraft:cocoa" , "age": 2, "facing": "east"                   } }, 
                { "pos": [-1, 2, 0], "is": {"id": "minecraft:piston",           "facing": "east", "extended": false} }  
            ]
        }, 
        { "at": 2, "do": "place", "pos": [-1, 3, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 2, 0], "is": {"id": "minecraft:piston"     , "extended": true, "facing": "east"} }, 
                { "pos": [ 0, 2, 0], "is": {"id": "minecraft:piston_head",                   "facing": "east"} }, 
                { "pos": [ 1, 2, 0], "is": {"id": "minecraft:jungle_log"                                     } }  
            ]
        }
    ], 
    "breakpoints": []
}

