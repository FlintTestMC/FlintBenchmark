{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cocoa_ignores_unrelated_neighbors", 
    "description": "Removing blocks next to, above, below and behind a cocoa pod, other than the log it faces, leaves the cocoa in place.", 
    "tags": ["vegetation", "cocoa", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:cocoa", "minecraft:jungle_log", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -3], [2, 4, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -3], [2, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 2,  0], "block": {"id": "minecraft:jungle_log"                             } }, 
                { "pos": [-1, 2, -1], "block": {"id": "minecraft:stone"                                  } }, 
                { "pos": [ 1, 2, -1], "block": {"id": "minecraft:stone"                                  } }, 
                { "pos": [ 0, 3, -1], "block": {"id": "minecraft:stone"                                  } }, 
                { "pos": [ 0, 1, -1], "block": {"id": "minecraft:stone"                                  } }, 
                { "pos": [ 0, 2, -2], "block": {"id": "minecraft:stone"                                  } }, 
                { "pos": [ 0, 2, -1], "block": {"id": "minecraft:cocoa"     , "age": 1, "facing": "south"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, -1], "is": {"id": "minecraft:cocoa", "age": 1, "facing": "south"} }
            ]
        }, 
        { "at": 2, "do": "remove", "pos": [-1, 2, -1] }, 
        { "at": 2, "do": "remove", "pos": [1, 2, -1] }, 
        { "at": 2, "do": "remove", "pos": [0, 3, -1] }, 
        { "at": 2, "do": "remove", "pos": [0, 1, -1] }, 
        { "at": 2, "do": "remove", "pos": [0, 2, -2] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [-1, 2, -1], "is": {"id": "minecraft:air"                                    } }, 
                { "pos": [ 1, 2, -1], "is": {"id": "minecraft:air"                                    } }, 
                { "pos": [ 0, 3, -1], "is": {"id": "minecraft:air"                                    } }, 
                { "pos": [ 0, 1, -1], "is": {"id": "minecraft:air"                                    } }, 
                { "pos": [ 0, 2, -2], "is": {"id": "minecraft:air"                                    } }, 
                { "pos": [ 0, 2,  0], "is": {"id": "minecraft:jungle_log"                             } }, 
                { "pos": [ 0, 2, -1], "is": {"id": "minecraft:cocoa"     , "age": 1, "facing": "south"} }  
            ]
        }
    ], 
    "breakpoints": []
}

