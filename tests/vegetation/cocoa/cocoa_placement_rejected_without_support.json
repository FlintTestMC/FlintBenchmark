{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cocoa_placement_rejected_without_support", 
    "description": "Cocoa beans do not place against a non-jungle log, or on top of a block with no jungle log beside the target space, and are not consumed.", 
    "tags": ["vegetation", "cocoa", "placement", "supports-cocoa", "player"], 
    "minecraftIds": [
        "minecraft:cocoa"      , "minecraft:cocoa_beans", "minecraft:oak_log"    , "minecraft:jungle_log" , 
        "minecraft:stone"      
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -3], [4, 5, 1] ]
        }, 
        "world": {
