                { "pos": [2, 2, 0], "block": {"id": "minecraft:stone"     } }, 
                { "pos": [3, 2, 0], "block": {"id": "minecraft:jungle_log"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, -2.5], "rot": [0, 0] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [2.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, -1], "is": {"id": "minecraft:air"                    }                    }, 
                { "pos": [2, 3,  0], "is": {"id": "minecraft:air"                    }                    }, 
                {                    "is": {"id": "minecraft:cocoa_beans", "count": 2}, "slot": "hotbar1" }  
            ]
        }
    ], 
