{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cocoa_placement_on_jungle_log", 
    "description": "Cocoa beans used on the side of a jungle log place an age-zero cocoa facing the log and consume one bean.", 
    "tags": ["vegetation", "cocoa", "placement", "player"], 
    "minecraftIds": ["minecraft:cocoa", "minecraft:cocoa_beans", "minecraft:jungle_log"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -3], [1, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:cocoa_beans", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -3], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:jungle_log"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, -2.5], "rot": [0, 0] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0] , "is": {"id": "minecraft:jungle_log"}                                            }, 
                { "pos": [0, 2, -1], "is": {"id": "minecraft:cocoa", "age": 0, "facing": "south"}                    }, 
                {                    "is": {"id": "minecraft:cocoa_beans", "count": 1}           , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

