{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cocoa_bonemeal_growth", 
    "description": "Each bone meal raises cocoa by exactly one age and is consumed, and bone meal on fully grown cocoa does nothing and is not consumed.", 
    "tags": ["vegetation", "cocoa", "bone-meal", "growth", "player"], 
    "minecraftIds": ["minecraft:cocoa", "minecraft:bone_meal", "minecraft:jungle_log"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -4], [1, 3, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 3
            }
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:bone_meal", "count": 3} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -4], [1, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:jungle_log"} }, 
        { "at": 0, "do": "place", "pos": [0, 2, -1], "block": {"id": "minecraft:cocoa", "age": 0, "facing": "south"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, -3.5], "rot": [0, 0] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, -1], "is": {"id": "minecraft:cocoa", "age": 1, "facing": "south"}                    }, 
                {                    "is": {"id": "minecraft:bone_meal", "count": 2}             , "slot": "hotbar1" }  
            ]
        }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, -1], "is": {"id": "minecraft:cocoa", "age": 2, "facing": "south"}                    }, 
                {                    "is": {"id": "minecraft:bone_meal", "count": 1}             , "slot": "hotbar1" }  
            ]
        }, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, -1], "is": {"id": "minecraft:cocoa", "age": 2, "facing": "south"}                    }, 
                {                    "is": {"id": "minecraft:bone_meal", "count": 1}             , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

