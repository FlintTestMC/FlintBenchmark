                { "pos": [1, 0, 0], "block": {"id": "minecraft:dirt"           } }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:farmland"       } }, 
                { "pos": [3, 0, 0], "block": {"id": "minecraft:moss_block"     } }, 
