{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "closed_eyeblossom_placement_on_supports", 
    "description": "A closed eyeblossom placed on grass, dirt, farmland, moss, pale moss or mud stays in place as a closed eyeblossom.", 
    "tags": ["vegetation", "eyeblossom", "placement", "support"], 
    "minecraftIds": [
