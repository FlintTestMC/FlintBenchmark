            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:closed_eyeblossom"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:closed_eyeblossom"} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:closed_eyeblossom"} }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:closed_eyeblossom"} }, 
                { "pos": [4, 1, 0], "is": {"id": "minecraft:closed_eyeblossom"} }, 
                { "pos": [5, 1, 0], "is": {"id": "minecraft:closed_eyeblossom"} }  
            ]
        }
    ], 
    "breakpoints": []
