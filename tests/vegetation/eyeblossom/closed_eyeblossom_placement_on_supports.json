        "minecraft:farmland"         , "minecraft:moss_block"       , "minecraft:pale_moss_block"  , 
        "minecraft:mud"              
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [6, 2, 1] ]
        }
    }, 
    "timeline": [
