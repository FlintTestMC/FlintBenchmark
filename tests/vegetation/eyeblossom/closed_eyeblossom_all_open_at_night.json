{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "closed_eyeblossom_all_open_at_night", 
    "description": "At night with fast random ticks each of four closed eyeblossoms in a row turns into its own open eyeblossom with the grass below and the air above unchanged (end state only; the neighbour chain reaction cannot be isolated from the random ticks).", 
    "tags": ["vegetation", "eyeblossom", "random-tick", "world-config"], 
    "minecraftIds": ["minecraft:closed_eyeblossom", "minecraft:open_eyeblossom", "minecraft:grass_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [4, 2, 1] ]
        }, 
        "world": {
            "time": "minecraft:midnight", 
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 4096
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [4, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [0, 1, 0], [3, 2, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 2, 
            "do": "fill", 
            "region": [ [0, 0, 0], [3, 0, 0] ], 
            "with": {"id": "minecraft:grass_block"}
        }, 
        {
            "at": 3, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:closed_eyeblossom"} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:closed_eyeblossom"} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:closed_eyeblossom"} }, 
                { "pos": [3, 1, 0], "block": {"id": "minecraft:closed_eyeblossom"} }  
            ]
        }, 
        {
            "at": 80, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:open_eyeblossom"} }, 
                { "pos": [0, 0, 0], "is": {"id": "minecraft:grass_block"    } }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"            } }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:open_eyeblossom"} }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:grass_block"    } }, 
                { "pos": [1, 2, 0], "is": {"id": "minecraft:air"            } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:open_eyeblossom"} }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:grass_block"    } }, 
                { "pos": [2, 2, 0], "is": {"id": "minecraft:air"            } }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:open_eyeblossom"} }, 
                { "pos": [3, 0, 0], "is": {"id": "minecraft:grass_block"    } }, 
                { "pos": [3, 2, 0], "is": {"id": "minecraft:air"            } }  
            ]
        }
    ], 
    "breakpoints": []
}

