{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "allium_placement_rejected_on_invalid_blocks", 
    "description": "Using alliums on the top face of stone, sand and gravel places nothing because those blocks are not vegetation substrates, and no item is consumed.", 
    "tags": ["vegetation", "allium", "flower", "placement", "player", "support"], 
    "minecraftIds": ["minecraft:allium", "minecraft:stone", "minecraft:sand", "minecraft:gravel"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [3, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:allium", "count": 3} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, -1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [2, -1, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone" } }, 
                { "pos": [1, 0, 0], "block": {"id": "minecraft:sand"  } }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:gravel"} }  
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [1.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact"}, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 4, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:stone"             }                    }, 
                { "pos": [1, 0, 0], "is": {"id": "minecraft:sand"              }                    }, 
                { "pos": [2, 0, 0], "is": {"id": "minecraft:gravel"            }                    }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"               }                    }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"               }                    }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"               }                    }, 
                {                   "is": {"id": "minecraft:allium", "count": 3}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

