                { "pos": [3, 0, 0], "block": {"id": "minecraft:moss_block" } }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:mud"        } }, 
                { "pos": [5, 0, 0], "block": {"id": "minecraft:farmland"   } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [1.5, 2, 0.5], "rot": [0, 90] }, 
