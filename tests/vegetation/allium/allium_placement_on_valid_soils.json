                { "pos": [0, 1, 0], "is": {"id": "minecraft:allium"}                    }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:allium"}                    }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:allium"}                    }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:allium"}                    }, 
