{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "allium_placement_on_valid_soils", 
    "description": "Survival placement of alliums on the top face of grass block, dirt, podzol, moss block, mud and farmland creates an allium on each and consumes all six items.", 
    "tags": ["vegetation", "allium", "flower", "placement", "player"], 
    "minecraftIds": [
        "minecraft:allium"     , "minecraft:grass_block", "minecraft:dirt"       , "minecraft:podzol"     , 
        "minecraft:moss_block" , "minecraft:mud"        , "minecraft:farmland"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [6, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:allium", "count": 6} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
