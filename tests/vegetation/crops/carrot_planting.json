{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "carrot_planting", 
    "description": "A carrot used on farmland plants age-zero carrots and is consumed, while a carrot used on dirt plants nothing and is kept.", 
    "tags": ["vegetation", "crop", "carrot", "placement", "player"], 
    "minecraftIds": ["minecraft:farmland", "minecraft:dirt", "minecraft:carrot", "minecraft:carrots"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 4, 
            "do": "fill", 
            "region": [ [-1, 1, -1], [3, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        {
            "at": 4, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:farmland"} }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:dirt"    } }  
            ]
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact", "item": "minecraft:carrot"}, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [2.5, 5, 0.5] }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"               }                    }, 
                {                   "is": {"id": "minecraft:carrot", "count": 1}, "slot": "hotbar1" }  
            ]
        }, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 6, "do": "interact", "item": "minecraft:carrot"}, 
        { "at": 6, "do": "tp", "entity_alias": "player", "pos": [0.5, 5, 0.5] }, 
        {
            "at": 7, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:farmland"}                             }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:carrots", "age": 0}                    }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"}                                  }, 
                {                   "is": "empty"                              , "slot": "hotbar1" }  
            ]
        }, 
        { "at": 7, "do": "remove", "pos": [0, 1, 0] }
    ], 
    "breakpoints": []
}

