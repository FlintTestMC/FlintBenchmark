                { "pos": [ 0, 1, -1], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:water"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
