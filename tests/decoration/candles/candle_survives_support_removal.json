{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "candle_survives_support_removal", 
    "description": "A placed candle stays in place when the block below it is removed.", 
    "tags": ["decoration", "candle", "player"], 
    "minecraftIds": ["minecraft:candle", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {"inventory": {}, "selected_hotbar": 1, "game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:candle"} }, 
        { "at": 1, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"                 } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:candle", "candles": 1} }  
            ]
        }
    ], 
    "breakpoints": []
}

