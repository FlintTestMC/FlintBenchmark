{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Campfire Signal Fire Follows Block Below", 
    "description": "An existing campfire becomes a signal fire when a hay bale is placed directly below it, and stops being one when the hay is replaced by stone or removed (updateShape re-evaluates signal_fire on downward neighbour changes).", 
    "tags": ["campfire", "signal-fire", "hay", "neighbor-update", "block-state"], 
    "minecraftIds": ["minecraft:campfire", "minecraft:hay_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {"id": "minecraft:campfire", "lit": true, "signal_fire": false, "facing": "north"}
                }
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:campfire", "lit": true, "signal_fire": false} }
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:hay_block", "axis": "y"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:campfire", "lit": true, "signal_fire": true} }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:campfire", "lit": true, "signal_fire": false} }
            ]
        }, 
        { "at": 3, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:hay_block", "axis": "y"} }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:campfire", "lit": true, "signal_fire": true} }
            ]
        }, 
        { "at": 4, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"                                        } }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:campfire", "lit": true, "signal_fire": false} }  
            ]
        }
    ], 
    "breakpoints": []
}

