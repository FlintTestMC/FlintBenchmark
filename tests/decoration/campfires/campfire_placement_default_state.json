{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Campfire Placement Default State", 
    "description": "A campfire placed by a survival player on stone is lit, not a signal fire, not waterlogged, faces the player's horizontal direction (yaw 0 = south, yaw 90 = west), and consumes the item.", 
    "tags": ["campfire", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:campfire"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, 0], [1, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 0, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 0, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [-0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:campfire"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [-1, 1, 0], 
                    "is": {
                        "id": "minecraft:campfire", 
                        "lit": true, 
                        "signal_fire": false, 
                        "waterlogged": false, 
                        "facing": "south"
                    }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [1.5, 3, 0.5], "rot": [90, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:campfire"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": {
                        "id": "minecraft:campfire", 
                        "lit": true, 
                        "signal_fire": false, 
                        "waterlogged": false, 
                        "facing": "west"
                    }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

