{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Campfire Fire Charge Lights", 
    "description": "Using a fire charge on an unlit, non-waterlogged campfire lights it and consumes the fire charge for a survival player.", 
    "tags": ["campfire", "fire-charge", "ignite", "block-state", "player"], 
    "minecraftIds": ["minecraft:campfire", "minecraft:fire_charge"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                                       } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:campfire", "lit": false, "waterlogged": false} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:fire_charge"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:campfire", "lit": true, "waterlogged": false} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"} }                                        , 
                {"slot": "hotbar1", "is": "empty"}                                                           
            ]
        }
    ], 
    "breakpoints": []
}

