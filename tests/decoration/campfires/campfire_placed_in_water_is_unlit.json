{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Campfire Placed In Water Is Unlit", 
    "description": "A campfire placed by a player into a water source block becomes waterlogged and starts unlit (getStateForPlacement sets lit = !replacedWater).", 
    "tags": ["campfire", "placement", "waterlogging", "water", "block-state", "player"], 
    "minecraftIds": ["minecraft:campfire", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 1, 1] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 0,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [-1, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1, -1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  0], "block": {"id": "minecraft:water"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water"} }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:campfire"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:campfire", "lit": false, "waterlogged": true, "signal_fire": false}
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

