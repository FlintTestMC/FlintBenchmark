{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Soul Campfire Placement And Signal Fire", 
    "description": "Representative test for minecraft:soul_campfire (CampfireBlock with spawnParticles=false, fireDamage=2, light 10, soul_soil drop). A player-placed soul campfire on stone is lit, not a signal fire, not waterlogged and faces the player; placed on a hay bale it is a lit signal fire. Notes: its member-specific differences (fire damage 2, light level 10, no lava particles, piglin repelling, soul_soil/silk-touch drops) are intentionally untested because they need entities, light-level or client-side assertions, or a block-break action, none of which Flint supports.", 
    "tags": ["campfire", "soul-campfire", "placement", "signal-fire", "hay", "block-state", "player"], 
    "minecraftIds": ["minecraft:soul_campfire", "minecraft:hay_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, 0], [1, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 0, 0], "block": {"id": "minecraft:stone"                 } }, 
                { "pos": [ 1, 0, 0], "block": {"id": "minecraft:hay_block", "axis": "y"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [-0.5, 3, 0.5], "rot": [180, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:soul_campfire"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [-1, 1, 0], 
                    "is": {
                        "id": "minecraft:soul_campfire", 
                        "lit": true, 
                        "signal_fire": false, 
                        "waterlogged": false, 
                        "facing": "north"
                    }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [1.5, 3, 0.5], "rot": [-90, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:soul_campfire"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": {
                        "id": "minecraft:soul_campfire", 
                        "lit": true, 
                        "signal_fire": true, 
                        "waterlogged": false, 
                        "facing": "east"
                    }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

