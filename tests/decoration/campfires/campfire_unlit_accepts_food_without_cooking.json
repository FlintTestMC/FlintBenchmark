{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Campfire Unlit Accepts Food Without Cooking", 
    "description": "CampfireBlock.useItemOn does not check lit, so raw beef can be placed on an unlit campfire, but the unlit cooldown ticker never advances cooking: twenty ticks later the beef is still there with cooking progress 0.", 
    "tags": ["campfire", "block-entity", "cooking", "food", "edge-case", "player"], 
    "minecraftIds": ["minecraft:campfire", "minecraft:beef"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id": "minecraft:campfire", 
                        "lit": false, 
                        "waterlogged": false, 
                        "signal_fire": false, 
                        "facing": "north"
                    }
                }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:beef"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:campfire", 
                        "nbt": {"Items[0].id": "minecraft:beef", "CookingTimes[0]": 0, "CookingTotalTimes[0]": 600}, 
                        "lit": false
                    }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }, 
        {
            "at": 22, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:campfire", 
                        "nbt": {"Items[0].id": "minecraft:beef", "CookingTimes[0]": 0}, 
                        "lit": false
                    }
                }
            ]
        }
    ], 
    "breakpoints": []
}

