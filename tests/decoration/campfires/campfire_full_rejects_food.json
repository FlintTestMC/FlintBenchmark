{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Campfire Full Rejects Food", 
    "description": "A survival player fills all four campfire slots with raw beef one at a time (slots 0..3 in order); a fifth raw beef is refused because placeFood finds no empty slot, so the campfire contents are unchanged and the player keeps the beef.", 
    "tags": ["campfire", "block-entity", "cooking", "food", "edge-case", "player"], 
    "minecraftIds": ["minecraft:campfire", "minecraft:beef"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
                {
                    "pos": [0, 1, 0], 
                    "block": {
                        "id": "minecraft:campfire", 
                        "lit": true, 
                        "waterlogged": false, 
                        "signal_fire": false, 
                        "facing": "north"
                    }
                }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:beef"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:beef"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact", "item": "minecraft:beef"}, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 4, "do": "interact", "item": "minecraft:beef"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:campfire", 
                        "nbt": {
                            "Items[0].id"      : "minecraft:beef"         , 
                            "Items[1].id"      : "minecraft:beef"         , 
                            "Items[2].id"      : "minecraft:beef"         , 
                            "Items[3].id"      : "minecraft:beef"         , 
                            "CookingTotalTimes": "[I; 600, 600, 600, 600]"  
                        }
                    }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }, 
        { "at": 5, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact", "item": "minecraft:beef"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {
                        "id": "minecraft:campfire", 
                        "nbt": {
                            "Items[3].id": "minecraft:beef", 
                            "Items[3].count": 1, 
                            "CookingTotalTimes": "[I; 600, 600, 600, 600]"
                        }
                    }
                }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:beef", "count": 1} }
            ]
        }
    ], 
    "breakpoints": []
}

