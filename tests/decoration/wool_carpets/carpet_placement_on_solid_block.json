{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "carpet_placement_on_solid_block", 
    "description": "A survival player placing a white carpet on top of stone creates a white carpet above the stone and uses up the item.", 
    "tags": ["decoration", "carpet", "wool-carpets", "placement", "player"], 
    "minecraftIds": ["minecraft:white_carpet", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:white_carpet", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:stone"}                           }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:white_carpet"}                    }, 
                {                   "is": "empty"                         , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

