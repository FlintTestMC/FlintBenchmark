{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "carpet_replaced_by_flowing_water", 
    "description": "Water spreading from a source block into the space of a white carpet destroys the carpet and fills the space with flowing water. The floor is 11x11 so no edge hole lies within the 4-block slope search of FlowingFluid.getSpread, which would otherwise steer the water toward the nearest edge instead of every side.", 
    "tags": ["decoration", "carpet", "wool-carpets", "fluid", "water", "replacement"], 
    "minecraftIds": ["minecraft:white_carpet", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-5, 0, -5], [5, 2, 5] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-5, 0, -5], [5, 0, 5] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:white_carpet"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [ 1, 1, 0], "is": {"id": "minecraft:white_carpet"} }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:air"         } }, 
                { "pos": [ 0, 1, 1], "is": {"id": "minecraft:air"         } }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:water", "level": 0} }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [ 0, 1, 0], "is": {"id": "minecraft:water", "level": 0} }, 
                { "pos": [-1, 1, 0], "is": {"id": "minecraft:water", "level": 1} }, 
                { "pos": [ 0, 1, 1], "is": {"id": "minecraft:water", "level": 1} }, 
                { "pos": [ 1, 1, 0], "is": {"id": "minecraft:water", "level": 1} }  
            ]
        }
    ], 
    "breakpoints": []
}

