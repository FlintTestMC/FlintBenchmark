{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "carpet_support_loss_drops_item", 
    "description": "Removing the block under a white carpet turns the carpet into air and drops one white carpet item.", 
    "tags": ["decoration", "carpet", "wool-carpets", "support", "neighbor-update", "drops"], 
    "minecraftIds": ["minecraft:white_carpet", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:white_carpet"} }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:white_carpet"}                  }, 
                {                   "is": "minecraft:item"                , "exists": false }  
            ]
        }, 
        { "at": 1, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }, 
                {
                    "is": "minecraft:item", 
                    "exists": true, 
                    "count": 1, 
                    "pos": [0.5, 1.2, 0.5], 
                    "position_tolerance": 1.5, 
                    "Item.id": "minecraft:white_carpet"
                }
            ]
        }
    ], 
    "breakpoints": []
}

