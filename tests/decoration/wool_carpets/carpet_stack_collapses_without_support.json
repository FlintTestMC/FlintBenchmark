{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "carpet_stack_collapses_without_support", 
    "description": "Removing the block under a stack of three white carpets clears the whole stack from the bottom up and drops three white carpet items.", 
    "tags": ["decoration", "carpet", "wool-carpets", "support", "neighbor-update", "drops"], 
    "minecraftIds": ["minecraft:white_carpet", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 4, 1] ]
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:white_carpet"} }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:white_carpet"} }, 
                { "pos": [0, 3, 0], "block": {"id": "minecraft:white_carpet"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:white_carpet"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:white_carpet"} }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:white_carpet"} }  
            ]
        }, 
        { "at": 1, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:air"}                             }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"}                             }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"}                             }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:air"}                             }, 
                {                   "is": "minecraft:item"       , "exists": true, "count": 3 }  
            ]
        }
    ], 
    "breakpoints": []
}

