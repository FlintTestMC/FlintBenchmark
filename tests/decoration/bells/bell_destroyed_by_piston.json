{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bell_destroyed_by_piston", 
    "description": "A piston pushing into a bell destroys it instead of moving it, and the bell drops as one item.", 
    "tags": ["decoration", "bell", "piston", "push-reaction", "drops", "redstone"], 
    "minecraftIds": [
        "minecraft:bell"          , "minecraft:piston"        , "minecraft:piston_head"   , "minecraft:stone"         , 
        "minecraft:redstone_block"
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east"                        } }, 
                { "pos": [1, 0, 0], "block": {"id": "minecraft:stone"                                           } }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:bell"  , "facing": "north", "attachment": "floor"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": {"id": "minecraft:bell", "attachment": "floor", "facing": "north", "powered": false}
                }, 
                {"is": "minecraft:item", "exists": false}
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "extended": true, "facing": "east"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"} }             , 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"} }                                       , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:bell"}           
            ]
        }
    ], 
    "breakpoints": []
}

