{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bell_power_updates_only_on_neighbor_change", 
    "description": "A bell placed next to an existing redstone block stays unpowered until a neighbouring block changes, then becomes powered.", 
    "tags": ["decoration", "bell", "redstone", "block-state", "neighbor-update"], 
    "minecraftIds": ["minecraft:bell", "minecraft:stone", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 3, 0] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"         } }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:redstone_block"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {"id": "minecraft:bell", "attachment": "floor", "facing": "east"}
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:bell", "attachment": "floor", "facing": "east", "powered": false}
                }
            ]
        }, 
        { "at": 2, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": {"id": "minecraft:bell", "attachment": "floor", "facing": "east", "powered": true}
                }
            ]
        }
    ], 
    "breakpoints": []
}

