{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bell_single_wall_loses_support", 
    "description": "A wall bell hanging from one block is destroyed and drops one bell item when that block is removed. The bell is placed by the player because the flint bot reports wall attachments as 'singlewall'/'doublewall', so they cannot be placed or asserted with the vanilla names.", 
    "tags": ["decoration", "bell", "support", "neighbor-update", "drops", "player"], 
    "minecraftIds": ["minecraft:bell", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 5, 0] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:bell", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [3.5, 0, 0.5], "rot": [90, 0] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:bell", "facing": "west", "powered": false} }
            ]
        }, 
        { "at": 2, "do": "remove", "pos": [0, 1, 0] }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"} }                              , 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"} }                              , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:bell"}  
            ]
        }
    ], 
    "breakpoints": []
}

