{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "amethyst_cluster_destroyed_by_piston", 
    "description": "An extending piston destroys an amethyst cluster in its path instead of pushing it, and the cluster drops two amethyst shards.", 
    "tags": ["decoration", "amethyst-cluster", "piston", "push-reaction", "drops"], 
    "minecraftIds": [
        "minecraft:amethyst_cluster", "minecraft:piston"          , "minecraft:piston_head"     , 
        "minecraft:redstone_block"  , "minecraft:amethyst_shard"  , "minecraft:item"            , 
        "minecraft:stone"           
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston", "facing": "east", "extended": false} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:amethyst_cluster", "facing": "up"}            }  
            ]
        }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": false} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:amethyst_cluster", "facing": "up"} }           , 
                {"is": "minecraft:item", "exists": false}                                                    
            ]
        }, 
        { "at": 3, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston", "facing": "east", "extended": true} }  , 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"} }               , 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"} }                                         , 
                {"is": "minecraft:item", "count": 1, "Item.id": "minecraft:amethyst_shard", "Item.count": 2}  
            ]
        }
    ], 
    "breakpoints": []
}

