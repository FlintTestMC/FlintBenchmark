{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "amethyst_cluster_waterlogged_placement", 
    "description": "An amethyst cluster placed into a water source becomes waterlogged, while one placed into air is not waterlogged.", 
    "tags": ["decoration", "amethyst-cluster", "placement", "waterlogged", "player"], 
    "minecraftIds": ["minecraft:amethyst_cluster", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [4, 2, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:amethyst_cluster", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [4, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [-1, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1, -1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 1,  0], "block": {"id": "minecraft:water"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water"} }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:air"  } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [3.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:amethyst_cluster", "facing": "up", "waterlogged": true } }, 
                { "pos": [3, 1, 0], "is": {"id": "minecraft:amethyst_cluster", "facing": "up", "waterlogged": false} }  
            ]
        }
    ], 
    "breakpoints": []
}

