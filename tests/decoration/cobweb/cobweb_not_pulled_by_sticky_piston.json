{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cobweb_not_pulled_by_sticky_piston", 
    "description": "A retracting sticky piston does not pull a cobweb touching its head; the cobweb stays in place.", 
    "tags": ["decoration", "cobweb", "piston", "sticky-piston", "push-reaction", "redstone"], 
    "minecraftIds": ["minecraft:cobweb", "minecraft:sticky_piston"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {"id": "minecraft:sticky_piston", "facing": "east", "extended": "false"}
        }, 
        { "at": 1, "do": "place", "pos": [-1, 1, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:sticky_piston", "facing": "east", "extended": "true"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east", "type": "sticky"}     }  
            ]
        }, 
        { "at": 6, "do": "place", "pos": [2, 1, 0], "block": {"id": "minecraft:cobweb"} }, 
        { "at": 7, "do": "remove", "pos": [-1, 1, 0] }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:sticky_piston", "facing": "east", "extended": "false"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"                                                 } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:cobweb"                                              } }  
            ]
        }
    ], 
    "breakpoints": []
}

