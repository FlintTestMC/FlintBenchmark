{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cobweb_supports_falling_block", 
    "description": "Sand resting on a cobweb does not fall, because a cobweb is not free space for falling blocks; sand over air beside it falls.", 
    "tags": ["decoration", "cobweb", "falling-block", "sand", "gravity"], 
    "minecraftIds": ["minecraft:cobweb", "minecraft:sand"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 0, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:cobweb"} }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 2, 0], "block": {"id": "minecraft:sand"} }, 
                { "pos": [2, 2, 0], "block": {"id": "minecraft:sand"} }  
            ]
        }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:cobweb"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:sand"  } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:sand"  } }, 
                { "pos": [2, 2, 0], "is": {"id": "minecraft:air"   } }  
            ]
        }
    ], 
    "breakpoints": []
}

