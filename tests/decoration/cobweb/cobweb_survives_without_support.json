            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:stone" } }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:cobweb"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:cobweb"} }
            ]
        }, 
        { "at": 1, "do": "remove", "pos": [0, 1, 0] }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:air"   } }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:cobweb"} }  
            ]
        }
    ], 
    "breakpoints": []
}

