{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cobweb_survives_without_support", 
    "description": "A cobweb has no support requirement: removing the block beneath it leaves the cobweb floating in place.", 
    "tags": ["decoration", "cobweb", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:cobweb"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
