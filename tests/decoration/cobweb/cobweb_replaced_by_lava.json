{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "cobweb_replaced_by_lava", 
    "description": "Flowing lava spreads into a cobweb in a one-wide channel, replacing it and continuing past it.", 
    "tags": ["decoration", "cobweb", "fluid", "lava"], 
    "minecraftIds": ["minecraft:cobweb", "minecraft:lava"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [0, 1, 0], [2, 1, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 1, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:cobweb"} }, 
        { "at": 2, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:lava", "level": 0} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:lava"  , "level": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:cobweb"            } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"               } }  
            ]
        }, 
        {
            "at": 100, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:lava", "level": 0} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:lava", "level": 2} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:lava", "level": 4} }  
            ]
        }
    ], 
    "breakpoints": []
}

