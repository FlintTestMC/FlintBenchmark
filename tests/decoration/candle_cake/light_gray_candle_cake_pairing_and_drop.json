{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Light Gray Candle Cake Pairing And Drop", 
    "description": "Using a light_gray candle on a cake makes a light_gray candle cake, and eating it drops a light_gray candle.", 
    "tags": ["decoration", "candle_cake", "cake", "candle", "drops"], 
    "minecraftIds": ["minecraft:light_gray_candle_cake", "minecraft:cake", "minecraft:light_gray_candle"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 3, 0] ]
        }, 
        "player": {
            "game_mode": "Creative", 
            "inventory": { "hotbar1": {"id": "minecraft:light_gray_candle", "count": 1} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:cake" , "bites": 0} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:light_gray_candle"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:light_gray_candle_cake", "lit": false} }
            ]
        }, 
        {"at": 3, "do": "set_slot", "slot": "hotbar1"}, 
        {"at": 3, "do": "interact"}, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:cake", "bites": 1} }                              , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:light_gray_candle"}  
            ]
        }
    ], 
    "breakpoints": []
}

