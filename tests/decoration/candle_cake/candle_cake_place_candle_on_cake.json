{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Candle Cake Place Candle On Cake", 
    "description": "Using a candle on an uneaten cake turns it into an unlit candle cake and consumes the candle in survival.", 
    "tags": ["decoration", "candle_cake", "cake", "candle", "interaction"], 
    "minecraftIds": ["minecraft:candle_cake", "minecraft:cake", "minecraft:candle"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 2, 0] ]
        }, 
        "player": {
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:candle", "count": 1} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:cake" , "bites": 0} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:candle"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:candle_cake", "lit": false}                    }, 
                {                   "is": "empty"                                      , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

