{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Candle Cake Eat Lit With Unrelated Item", 
    "description": "Clicking a lit candle cake while holding an unrelated item eats it rather than putting it out.", 
    "tags": ["decoration", "candle_cake", "cake", "candle", "interaction", "drops"], 
    "minecraftIds": ["minecraft:candle_cake", "minecraft:cake", "minecraft:candle", "minecraft:stick"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 3, 0] ]
        }, 
        "player": {
            "game_mode": "Creative", 
            "inventory": { "hotbar1": {"id": "minecraft:stick", "count": 1} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                   } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:candle_cake", "lit": true} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:stick"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:cake", "bites": 1} }                   , 
                {"is": "minecraft:item", "exists": true, "count": 1, "Item.id": "minecraft:candle"}, 
                { "slot": "hotbar1", "is": {"id": "minecraft:stick", "count": 1} }                   
            ]
        }
    ], 
    "breakpoints": []
}

