{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Candle Cake Fire Charge Lights", 
    "description": "Using a fire charge on an unlit candle cake lights it and consumes the fire charge in survival.", 
    "tags": ["decoration", "candle_cake", "candle", "fire_charge", "interaction"], 
    "minecraftIds": ["minecraft:candle_cake", "minecraft:fire_charge"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 3, 0] ]
        }, 
        "player": {
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:fire_charge", "count": 1} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"                    } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:candle_cake", "lit": false} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:fire_charge"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:candle_cake", "lit": true}                    }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"}                                         }, 
                {                   "is": "empty"                                     , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

