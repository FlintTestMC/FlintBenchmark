                { "pos": [8, 1, 0], "is": {"id": "minecraft:red_banner", "rotation": 0}                    }, 
                { "pos": [8, 2, 0], "is": {"id": "minecraft:red_banner", "rotation": 8}                    }, 
                {                   "is": {"id": "minecraft:red_banner", "count": 2}   , "slot": "hotbar1" }  
