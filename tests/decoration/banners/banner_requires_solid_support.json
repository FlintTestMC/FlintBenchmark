{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "banner_requires_solid_support", 
    "description": "A banner cannot be placed against the underside of a floating block or on top of a torch (no item consumed), but can be placed on top of another banner because banners count as solid.", 
    "tags": ["decoration", "banner", "placement", "support", "player"], 
    "minecraftIds": ["minecraft:red_banner", "minecraft:torch", "minecraft:stone"], 
