                { "pos": [8, 1, 0], "block": {"id": "minecraft:red_banner", "rotation": 0} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, -1, 0.5], "rot": [0, -90] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [4.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
