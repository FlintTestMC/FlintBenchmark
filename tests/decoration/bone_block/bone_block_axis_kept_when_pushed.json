{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bone_block_axis_kept_when_pushed", 
    "description": "A bone block pushed one block by a sticky piston and pulled back again keeps its axis at both positions.", 
    "tags": ["decoration", "bone-block", "pillar", "block-state", "piston"], 
    "minecraftIds": ["minecraft:bone_block", "minecraft:sticky_piston", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                {
                    "pos": [0, 1, 0], 
                    "block": {"id": "minecraft:sticky_piston", "facing": "east", "extended": "false"}
                }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:bone_block", "axis": "z"} }
            ]
        }, 
        { "at": 1, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:bone_block", "axis": "z"} }
            ]
        }, 
        { "at": 7, "do": "remove", "pos": [0, 0, 0] }, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:bone_block", "axis": "z"} }
            ]
        }
    ], 
    "breakpoints": []
}

