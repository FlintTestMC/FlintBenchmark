{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bee_nest_placement_facing", 
    "description": "A bee nest placed by a survival player faces opposite the player's horizontal look direction and starts at honey level zero.", 
    "tags": ["decoration", "bee-nest", "placement", "block-state", "player"], 
    "minecraftIds": ["minecraft:bee_nest"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-4, 0, -4], [4, 3, 4] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:bee_nest", "count": 4} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-4, 0, -4], [4, 0, 4] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, -2.5], "rot": [0, 45] }, 
        {"at": 1, "do": "interact"}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 1, 2.5], "rot": [180, 45] }, 
        {"at": 2, "do": "interact"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [-2.5, 1, 3.5], "rot": [-90, 45] }, 
        {"at": 3, "do": "interact"}, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [2.5, 1, -3.5], "rot": [90, 45] }, 
        {"at": 4, "do": "interact"}, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, -1], "is": {"id": "minecraft:bee_nest", "facing": "north", "honey_level": 0} }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:bee_nest", "facing": "south", "honey_level": 0} } , 
                { "pos": [-1, 1, 3], "is": {"id": "minecraft:bee_nest", "facing": "west", "honey_level": 0} } , 
                { "pos": [0, 1, -4], "is": {"id": "minecraft:bee_nest", "facing": "east", "honey_level": 0} } , 
                {"slot": "hotbar1", "is": "empty"}                                                              
            ]
        }
    ], 
    "breakpoints": []
}

