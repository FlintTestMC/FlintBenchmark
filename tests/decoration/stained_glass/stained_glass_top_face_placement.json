{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "stained_glass_top_face_placement", 
    "description": "Survival placement on top of a stone block creates red stained glass above it and consumes the item.", 
    "tags": ["decoration", "stained-glass", "placement", "player"], 
    "minecraftIds": ["minecraft:red_stained_glass", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:red_stained_glass", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:stone"                        }                    }, 
                { "pos": [0, 1, 0], "is": {"id": "minecraft:red_stained_glass"            }                    }, 
                {                   "is": {"id": "minecraft:air"              , "count": 0}, "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

