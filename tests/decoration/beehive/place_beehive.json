{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:beehive"], 
    "name": "Place Beehive", 
    "description": "Placing a beehive on stone creates an empty hive with honey_level 0 facing the player and consumes the item.", 
    "tags": ["block-entity", "beehive", "placement", "block-state"], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:beehive", "count": 1}, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 1, 0], 
                    "is": { "id": "minecraft:beehive", "honey_level": 0, "facing": "north", "nbt": {"bees": []} }
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ]
}

