{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:beehive", "minecraft:glass_bottle", "minecraft:honey_bottle"], 
    "name": "Beehive Bottle Collect Honey", 
    "description": "Using a glass bottle on a full beehive turns the bottle into a honey bottle and resets the honey level to 0.", 
    "tags": ["beehive", "glass-bottle", "honey-bottle", "interaction"], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [0, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, 0, 0], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 1, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {"id": "minecraft:beehive", "honey_level": 5, "facing": "east"}
        }, 
        {"at": 1, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:glass_bottle", "count": 1}, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:beehive", "honey_level": 0, "facing": "east"} }, 
                { "slot": "hotbar1", "is": {"id": "minecraft:honey_bottle"} }                                
            ]
        }
    ]
}

