{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "rail_waterlogged_placement", 
    "description": "Placing a rail into a water source block makes the rail waterlogged.", 
    "tags": ["transportation", "rail", "placement", "waterlogged", "player"], 
    "minecraftIds": ["minecraft:rail", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 3, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:rail", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 1,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 1, 2,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [-1, 2,  0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 2,  1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 2, -1], "block": {"id": "minecraft:stone"} }, 
                { "pos": [ 0, 2,  0], "block": {"id": "minecraft:water"} }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:water"} }
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:rail", "waterlogged": true}                    }, 
                {                   "is": {"id": "minecraft:air", "count": 0}          , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

