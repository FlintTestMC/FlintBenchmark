{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "rail_ascending_loses_slope_support", 
    "description": "A rail that slopes up onto a higher rail breaks when the block under that higher rail is removed, even though its own floor is intact.", 
    "tags": ["transportation", "rail", "slope", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:rail", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 4, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [1, 2, 0], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "place", "pos": [1, 3, 0], "block": {"id": "minecraft:rail"} }, 
        { "at": 2, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:rail"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stone"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:rail" } }, 
                { "pos": [1, 3, 0], "is": {"id": "minecraft:rail" } }  
            ]
        }, 
        { "at": 3, "do": "remove", "pos": [1, 2, 0] }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:stone"} }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air"  } }, 
                { "pos": [1, 3, 0], "is": {"id": "minecraft:air"  } }  
            ]
        }
    ], 
    "breakpoints": []
}

