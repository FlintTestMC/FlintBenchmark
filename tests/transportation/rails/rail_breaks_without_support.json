{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "rail_breaks_without_support", 
    "description": "A rail breaks into air when the block below it is removed, while a rail on an intact block stays.", 
    "tags": ["transportation", "rail", "support", "neighbor-update"], 
    "minecraftIds": ["minecraft:rail", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 3, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [3, 1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:rail" } }, 
                { "pos": [3, 2, 0], "block": {"id": "minecraft:rail" } }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:rail"} }, 
                { "pos": [3, 2, 0], "is": {"id": "minecraft:rail"} }  
            ]
        }, 
        { "at": 1, "do": "remove", "pos": [0, 1, 0] }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:air" } }, 
                { "pos": [3, 2, 0], "is": {"id": "minecraft:rail"} }  
            ]
        }
    ], 
    "breakpoints": []
}

