{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "Pane Placed In Fluids", 
    "description": "A pane placed into flowing water or lava is not waterlogged, because only a water source counts as water at placement.", 
    "tags": ["glass_pane", "block-state", "waterlogging", "fluid"], 
    "minecraftIds": ["minecraft:glass_pane", "minecraft:red_stained_glass_pane", "minecraft:water", "minecraft:lava"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 1, 0] ]
        }, 
        "player": {
            "game_mode": "Creative", 
            "inventory": {
                "hotbar1": {"id": "minecraft:glass_pane"            , "count": 1}, 
                "hotbar2": {"id": "minecraft:red_stained_glass_pane", "count": 1}  
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:stone"            } }, 
                { "pos": [0, 1, 0], "block": {"id": "minecraft:water", "level": 1} }, 
                { "pos": [2, 1, 0], "block": {"id": "minecraft:lava"             } }  
            ]
        }, 
        {
            "at": 1, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:water", "level": 1} }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:lava" , "level": 0} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:glass_pane"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:glass_pane", "waterlogged": false} }
            ]
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [2.5, 3, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:red_stained_glass_pane"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 1, 0], "is": {"id": "minecraft:red_stained_glass_pane", "waterlogged": false} }
            ]
        }
    ], 
    "breakpoints": []
}

