{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "shulker_box_destroyed_by_piston", 
    "description": "A piston pushing a shulker box destroys it instead of moving it, and the piston head takes its place.", 
    "tags": ["container", "shulker-box", "piston", "push-reaction", "redstone"], 
    "minecraftIds": ["minecraft:shulker_box", "minecraft:piston", "minecraft:redstone_block"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [3, 1, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [3, 0, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:piston"     , "facing": "east", "extended": false} }, 
                { "pos": [1, 1, 0], "block": {"id": "minecraft:shulker_box", "facing": "up"                     } }  
            ]
        }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:shulker_box", "facing": "up"} }
            ]
        }, 
        { "at": 3, "do": "place", "pos": [0, 1, 1], "block": {"id": "minecraft:redstone_block"} }, 
        {
            "at": 10, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:piston"     , "facing": "east", "extended": true} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:piston_head", "facing": "east"                  } }, 
                { "pos": [2, 1, 0], "is": {"id": "minecraft:air"                                            } }  
            ]
        }
    ], 
    "breakpoints": []
}

