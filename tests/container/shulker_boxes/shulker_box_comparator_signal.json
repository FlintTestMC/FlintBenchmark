{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "shulker_box_comparator_signal", 
    "description": "A comparator reading a shulker box outputs 0 when empty, 1 with a single item, and 3 with four full stacks (floor(4/27 * 14) + 1).", 
    "tags": ["container", "shulker-box", "comparator", "redstone", "block-entity"], 
    "minecraftIds": ["minecraft:shulker_box", "minecraft:comparator", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [1, 1, 4] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [1, 0, 4] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [1, 1, 0], "block": {"id": "minecraft:comparator", "facing": "west"} }, 
                { "pos": [1, 1, 2], "block": {"id": "minecraft:comparator", "facing": "west"} }, 
                { "pos": [1, 1, 4], "block": {"id": "minecraft:comparator", "facing": "west"} }  
            ]
        }, 
        {
            "at": 2, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:shulker_box", "facing": "up"} }, 
                {
                    "pos": [0, 1, 2], 
                    "block": {
                        "id": "minecraft:shulker_box", 
                        "facing": "up", 
                        "nbt": {"Items": "[{Slot: 0b, count: 1, id: \"minecraft:stone\"}]"}
                    }
                }, 
                {
                    "pos": [0, 1, 4], 
                    "block": {
                        "id": "minecraft:shulker_box", 
                        "facing": "up", 
                        "nbt": {
                            "Items": "[{Slot: 0b, count: 64, id: \"minecraft:stone\"}, {Slot: 1b, count: 64, id: \"minecraft:stone\"}, {Slot: 2b, count: 64, id: \"minecraft:stone\"}, {Slot: 3b, count: 64, id: \"minecraft:stone\"}]"
                        }
                    }
                }
            ]
        }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [1, 1, 0], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 0} }
                }, 
                {
                    "pos": [1, 1, 2], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 1} }
                }, 
                {
                    "pos": [1, 1, 4], 
                    "is": { "id": "minecraft:comparator", "nbt": {"OutputSignal": 3} }
                }
            ]
        }
    ], 
    "breakpoints": []
}

