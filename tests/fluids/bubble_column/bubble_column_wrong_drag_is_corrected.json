{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bubble_column_wrong_drag_is_corrected", 
    "description": "A bubble column with drag=true placed on soul sand keeps drag=true for 4 ticks and becomes drag=false on the 5th tick: updateColumn -> getColumnState uses the ENABLES_BUBBLE_COLUMN_PUSH_UP branch (BubbleColumnBlock lines 114-115). Source path: /setblock placement (BlockInput.place -> Block.updateFromNeighbourShapes) calls BubbleColumnBlock.updateShape (lines 161-179) for every direction; for DOWN it runs scheduleTick(pos, this, 5) (line 175), so tick() (lines 67-70) runs updateColumn exactly 5 ticks after placement.", 
    "tags": ["fluids", "bubble_column", "soul_sand"], 
    "minecraftIds": ["minecraft:bubble_column", "minecraft:soul_sand"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 4, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [2, 3, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [1, 1, 1], [1, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 0, 1], "block": {"id": "minecraft:soul_sand"} }, 
        { "at": 1, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:bubble_column", "drag": true} }, 
        {
            "at": 5, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:bubble_column", "drag": true} }
            ]
        }, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 0, 1], "is": {"id": "minecraft:soul_sand"                   } }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:bubble_column", "drag": false} }  
            ]
        }
    ], 
    "breakpoints": []
}

