{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bubble_column_cut_by_solid_block", 
    "description": "Placing a solid block inside a bubble column turns the part above it back into water while the part below stays a column.", 
    "tags": ["fluids", "bubble_column", "soul_sand", "support"], 
    "minecraftIds": ["minecraft:bubble_column", "minecraft:soul_sand", "minecraft:water", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 6, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [2, 5, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [1, 1, 1], [1, 5, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 0, 1], "block": {"id": "minecraft:soul_sand"} }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [1, 1, 1], [1, 4, 1] ], 
            "with": {"id": "minecraft:water", "level": 0}
        }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:bubble_column", "drag": false} }, 
                { "pos": [1, 4, 1], "is": {"id": "minecraft:bubble_column", "drag": false} }  
            ]
        }, 
        { "at": 31, "do": "place", "pos": [1, 3, 1], "block": {"id": "minecraft:stone"} }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:bubble_column", "drag": false            } }, 
                { "pos": [1, 2, 1], "is": {"id": "minecraft:bubble_column", "drag": false            } }, 
                { "pos": [1, 3, 1], "is": {"id": "minecraft:stone"                                   } }, 
                { "pos": [1, 4, 1], "is": {"id": "minecraft:water"        ,                "level": 0} }  
            ]
        }
    ], 
    "breakpoints": []
}

