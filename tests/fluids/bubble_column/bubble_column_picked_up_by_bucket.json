{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bubble_column_picked_up_by_bucket", 
    "description": "Using an empty bucket on the top segment of a bubble column removes it, gives a water bucket and leaves the segments below intact.", 
    "tags": ["fluids", "bubble_column", "bucket", "pickup"], 
    "minecraftIds": [
        "minecraft:bubble_column", "minecraft:soul_sand"    , "minecraft:water"        , "minecraft:bucket"       , 
        "minecraft:water_bucket" 
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 5, 2] ]
        }, 
        "player": {
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:bucket", "count": 1} }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [2, 4, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [1, 1, 1], [1, 4, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 0, "do": "place", "pos": [1, 0, 1], "block": {"id": "minecraft:soul_sand"} }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [1, 1, 1], [1, 3, 1] ], 
            "with": {"id": "minecraft:water", "level": 0}
        }, 
        {
            "at": 30, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 3, 1], "is": {"id": "minecraft:bubble_column", "drag": false} }
            ]
        }, 
        { "at": 31, "do": "tp", "entity_alias": "player", "pos": [1.5, 5, 1.5], "rot": [0, 90] }, 
        {"at": 32, "do": "interact", "item": "minecraft:bucket"}, 
        {
            "at": 34, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 3, 1], "is": {"id": "minecraft:air"}                                             }, 
                { "pos": [1, 2, 1], "is": {"id": "minecraft:bubble_column", "drag": false}                    }, 
                {                   "is": {"id": "minecraft:water_bucket", "count": 1}    , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

