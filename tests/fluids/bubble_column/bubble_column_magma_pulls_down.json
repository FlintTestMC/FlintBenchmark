{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "bubble_column_magma_pulls_down", 
    "description": "A water source placed on magma becomes a downward bubble column (drag=true) after the 20 tick scheduled update.", 
    "tags": ["fluids", "bubble_column", "magma"], 
    "minecraftIds": ["minecraft:bubble_column", "minecraft:magma_block", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [2, 3, 2] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [0, 0, 0], [2, 3, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [1, 1, 1], [1, 3, 1] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 1, "do": "place", "pos": [1, 0, 1], "block": {"id": "minecraft:magma_block"} }, 
        { "at": 2, "do": "place", "pos": [1, 1, 1], "block": {"id": "minecraft:water", "level": 0} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 1], "is": {"id": "minecraft:water"} }
            ]
        }, 
        {
            "at": 25, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 0, 1], "is": {"id": "minecraft:magma_block"                } }, 
                { "pos": [1, 1, 1], "is": {"id": "minecraft:bubble_column", "drag": true} }, 
                { "pos": [1, 2, 1], "is": {"id": "minecraft:air"                        } }  
            ]
        }
    ], 
    "breakpoints": []
}

