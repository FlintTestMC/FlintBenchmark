{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:egg"], 
    "name": "Throw Egg Stack Decrements", 
    "description": "Using one egg from a stack of 16 leaves 15 in the hand (EggItem.use -> itemStack.consume(1, player)).", 
    "tags": ["player", "egg", "stack"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [1, 3, 5] ]
        }, 
        "player": {"game_mode": "Survival"}
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, -1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, 0] }, 
        {"at": 0, "do": "set_slot", "slot": "hotbar1", "item": "minecraft:egg", "count": 16}, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "slot": "hotbar1", "is": {"id": "minecraft:egg", "count": 15} }
            ]
        }
    ]
}

