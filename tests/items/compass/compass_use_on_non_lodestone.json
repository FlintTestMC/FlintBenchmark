{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:compass", "minecraft:stone"], 
    "name": "compass_use_on_non_lodestone", 
    "description": "Using a stack of two compasses on a stone block does nothing: CompassItem.useOn falls back to Item.useOn, so the stack and the world stay unchanged.", 
    "tags": ["item", "compass", "interaction", "player"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [1, 3, 3] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:compass", "count": 2} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, -1, 0], "block": {"id": "minecraft:stone"} }, 
                { "pos": [0,  1, 2], "block": {"id": "minecraft:stone"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 0, 0.5], "rot": [0, 0] }, 
        {"at": 2, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "slot": "hotbar1", "is": {"id": "minecraft:compass", "count": 2}                   }, 
                { "slot": "hotbar2", "is": "empty"                                                   }, 
                {                    "is": {"id": "minecraft:stone"}              , "pos": [0, 1, 2] }, 
                {                    "is": {"id": "minecraft:air"}                , "pos": [0, 1, 1] }  
            ]
        }
    ]
}

