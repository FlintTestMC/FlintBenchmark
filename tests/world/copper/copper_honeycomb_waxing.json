{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "name": "copper_honeycomb_waxing", 
    "description": "Honeycomb turns each copper oxidation stage into its waxed counterpart and is consumed.", 
    "tags": ["copper", "weathering", "honeycomb", "wax", "player"], 
    "minecraftIds": [
        "minecraft:copper_block"    , "minecraft:exposed_copper"  , "minecraft:weathered_copper", 
        "minecraft:oxidized_copper" , "minecraft:honeycomb"       
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [0, 0, 0], [6, 1, 0] ]
        }, 
        "player": {"game_mode": "Survival"}, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 0, 0], "block": {"id": "minecraft:copper_block"    } }, 
                { "pos": [2, 0, 0], "block": {"id": "minecraft:exposed_copper"  } }, 
                { "pos": [4, 0, 0], "block": {"id": "minecraft:weathered_copper"} }, 
                { "pos": [6, 0, 0], "block": {"id": "minecraft:oxidized_copper" } }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 2, "do": "interact", "item": "minecraft:honeycomb"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:waxed_copper_block"}                    }, 
                {                   "is": "empty"                               , "slot": "hotbar1" }  
            ]
        }, 
        { "at": 4, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 5, "do": "interact", "item": "minecraft:honeycomb"}, 
        {
            "at": 6, 
            "do": "assert", 
            "checks": [
                { "pos": [2, 0, 0], "is": {"id": "minecraft:waxed_exposed_copper"}                    }, 
                {                   "is": "empty"                                 , "slot": "hotbar1" }  
            ]
        }, 
        { "at": 7, "do": "tp", "entity_alias": "player", "pos": [4.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 8, "do": "interact", "item": "minecraft:honeycomb"}, 
        {
            "at": 9, 
            "do": "assert", 
            "checks": [
                { "pos": [4, 0, 0], "is": {"id": "minecraft:waxed_weathered_copper"}                    }, 
                {                   "is": "empty"                                   , "slot": "hotbar1" }  
            ]
        }, 
        { "at": 10, "do": "tp", "entity_alias": "player", "pos": [6.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 11, "do": "interact", "item": "minecraft:honeycomb"}, 
        {
            "at": 12, 
            "do": "assert", 
            "checks": [
                { "pos": [6, 0, 0], "is": {"id": "minecraft:waxed_oxidized_copper"}                    }, 
                {                   "is": "empty"                                  , "slot": "hotbar1" }  
            ]
        }
    ], 
    "breakpoints": []
}

