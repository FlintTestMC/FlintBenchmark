{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.1", 
    "minecraftIds": ["minecraft:coal_ore", "minecraft:stone"], 
    "name": "coal_ore_placement", 
    "description": "A survival player places coal ore on top of stone, consuming the item; the placed block has no state and does not change over time.", 
    "tags": ["world", "ore", "coal-ore", "placement", "player"], 
    "setup": {
        "cleanup": {
            "region": [ [-1, -1, -1], [1, 3, 1] ]
        }, 
        "player": {
            "game_mode": "Survival", 
            "inventory": { "hotbar1": {"id": "minecraft:coal_ore"} }
        }
    }, 
    "timeline": [
        { "at": 0, "do": "place", "pos": [0, -1, 0], "block": {"id": "minecraft:stone"} }, 
        { "at": 0, "do": "tp", "entity_alias": "player", "pos": [0.5, 2, 0.5], "rot": [0, 90] }, 
        {"at": 1, "do": "interact", "item": "minecraft:coal_ore"}, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, -1, 0], "is": {"id": "minecraft:stone"}                       }, 
                { "pos": [0,  0, 0], "is": {"id": "minecraft:coal_ore"}                    }, 
                {                    "is": "empty"                     , "slot": "hotbar1" }  
            ]
        }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 0, 0], "is": {"id": "minecraft:coal_ore"} }
            ]
        }
    ]
}

