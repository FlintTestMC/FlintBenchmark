{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "budding_amethyst_all_directions", 
    "description": "A budding amethyst block with all six faces open to air grows buds on every face, each facing away from the block.", 
    "tags": ["world", "budding-amethyst", "random-tick", "direction", "amethyst"], 
    "minecraftIds": [
        "minecraft:budding_amethyst"   , "minecraft:small_amethyst_bud" , "minecraft:medium_amethyst_bud", 
        "minecraft:large_amethyst_bud" , "minecraft:amethyst_cluster"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -2], [2, 4, 2] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 6000
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -2], [2, 4, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [ 0, 3,  0], "block": {"id": "minecraft:air"             } }, 
                { "pos": [ 0, 1,  0], "block": {"id": "minecraft:air"             } }, 
                { "pos": [ 1, 2,  0], "block": {"id": "minecraft:air"             } }, 
                { "pos": [-1, 2,  0], "block": {"id": "minecraft:air"             } }, 
                { "pos": [ 0, 2,  1], "block": {"id": "minecraft:air"             } }, 
                { "pos": [ 0, 2, -1], "block": {"id": "minecraft:air"             } }, 
                { "pos": [ 0, 2,  0], "block": {"id": "minecraft:budding_amethyst"} }  
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:budding_amethyst"} }, 
                {
                    "pos": [0, 3, 0], 
                    "is": [
                        {"id": "minecraft:small_amethyst_bud" , "facing": "up"}, 
                        {"id": "minecraft:medium_amethyst_bud", "facing": "up"}, 
                        {"id": "minecraft:large_amethyst_bud" , "facing": "up"}, 
                        {"id": "minecraft:amethyst_cluster"   , "facing": "up"}  
                    ]
                }, 
                {
                    "pos": [0, 1, 0], 
                    "is": [
                        {"id": "minecraft:small_amethyst_bud" , "facing": "down"}, 
                        {"id": "minecraft:medium_amethyst_bud", "facing": "down"}, 
                        {"id": "minecraft:large_amethyst_bud" , "facing": "down"}, 
                        {"id": "minecraft:amethyst_cluster"   , "facing": "down"}  
                    ]
                }, 
                {
                    "pos": [1, 2, 0], 
                    "is": [
                        {"id": "minecraft:small_amethyst_bud" , "facing": "east"}, 
                        {"id": "minecraft:medium_amethyst_bud", "facing": "east"}, 
                        {"id": "minecraft:large_amethyst_bud" , "facing": "east"}, 
                        {"id": "minecraft:amethyst_cluster"   , "facing": "east"}  
                    ]
                }, 
                {
                    "pos": [-1, 2, 0], 
                    "is": [
                        {"id": "minecraft:small_amethyst_bud" , "facing": "west"}, 
                        {"id": "minecraft:medium_amethyst_bud", "facing": "west"}, 
                        {"id": "minecraft:large_amethyst_bud" , "facing": "west"}, 
                        {"id": "minecraft:amethyst_cluster"   , "facing": "west"}  
                    ]
                }, 
                {
                    "pos": [0, 2, 1], 
                    "is": [
                        {"id": "minecraft:small_amethyst_bud" , "facing": "south"}, 
                        {"id": "minecraft:medium_amethyst_bud", "facing": "south"}, 
                        {"id": "minecraft:large_amethyst_bud" , "facing": "south"}, 
                        {"id": "minecraft:amethyst_cluster"   , "facing": "south"}  
                    ]
                }, 
                {
                    "pos": [0, 2, -1], 
                    "is": [
                        {"id": "minecraft:small_amethyst_bud" , "facing": "north"}, 
                        {"id": "minecraft:medium_amethyst_bud", "facing": "north"}, 
                        {"id": "minecraft:large_amethyst_bud" , "facing": "north"}, 
                        {"id": "minecraft:amethyst_cluster"   , "facing": "north"}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

