{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "budding_amethyst_upgrades_placed_bud", 
    "description": "A medium amethyst bud facing away from a budding amethyst block is upgraded to a large bud and then a cluster.", 
    "tags": ["world", "budding-amethyst", "random-tick", "amethyst"], 
    "minecraftIds": [
        "minecraft:budding_amethyst"   , "minecraft:medium_amethyst_bud", "minecraft:large_amethyst_bud" , 
        "minecraft:amethyst_cluster"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -2], [2, 4, 2] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 6000
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -2], [2, 4, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 3, 0], "block": {"id": "minecraft:medium_amethyst_bud", "facing": "up"} }, 
                { "pos": [0, 2, 0], "block": {"id": "minecraft:budding_amethyst"                   } }  
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:budding_amethyst"} }, 
                {
                    "pos": [0, 3, 0], 
                    "is": [
                        {"id": "minecraft:large_amethyst_bud", "facing": "up"}, 
                        {"id": "minecraft:amethyst_cluster"  , "facing": "up"}  
                    ]
                }
            ]
        }
    ], 
    "breakpoints": []
}

