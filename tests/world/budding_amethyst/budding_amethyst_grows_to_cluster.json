{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "budding_amethyst_grows_to_cluster", 
    "description": "Random ticks grow a bud on the only open face of a budding amethyst block through small, medium and large stages into an amethyst cluster, which then stays unchanged.", 
    "tags": ["world", "budding-amethyst", "random-tick", "growth", "amethyst"], 
    "minecraftIds": [
        "minecraft:budding_amethyst"   , "minecraft:small_amethyst_bud" , "minecraft:medium_amethyst_bud", 
        "minecraft:large_amethyst_bud" , "minecraft:amethyst_cluster"   
    ], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-2, 0, -2], [2, 4, 2] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 6000
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-2, 0, -2], [2, 4, 2] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:air"} }, 
        { "at": 1, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:budding_amethyst"} }, 
        {
            "at": 2, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:budding_amethyst"} }
            ]
        }, 
        {
            "at": 200, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:budding_amethyst"                                      } }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:amethyst_cluster", "facing": "up", "waterlogged": false} }  
            ]
        }, 
        {
            "at": 260, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:amethyst_cluster", "facing": "up", "waterlogged": false} }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:stone"                                                 } }  
            ]
        }
    ], 
    "breakpoints": []
}

