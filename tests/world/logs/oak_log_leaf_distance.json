{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "oak_log_leaf_distance", 
    "description": "A leaf block next to an oak log gets distance 1, and returns to distance 7 once the log is removed.", 
    "tags": ["world", "log", "oak-log", "leaves", "distance", "block-update"], 
    "minecraftIds": ["minecraft:oak_log", "minecraft:oak_leaves"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [2, 2, 1] ]
        }, 
        "world": {
            "gamerules": {
                "minecraft:spawn_mobs": false, 
                "minecraft:advance_time": false, 
                "minecraft:advance_weather": false, 
                "minecraft:random_tick_speed": 0
            }
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place", 
            "pos": [0, 1, 0], 
            "block": {"id": "minecraft:oak_leaves", "distance": 7, "persistent": false}
        }, 
        { "at": 1, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:oak_log"} }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_leaves", "distance": 1, "persistent": false} }
            ]
        }, 
        { "at": 5, "do": "remove", "pos": [1, 1, 0] }, 
        {
            "at": 8, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:oak_leaves", "distance": 7, "persistent": false} }
            ]
        }
    ], 
    "breakpoints": []
}

