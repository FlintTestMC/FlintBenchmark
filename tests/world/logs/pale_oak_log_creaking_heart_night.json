{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "pale_oak_log_creaking_heart_night", 
    "description": "At night a creaking heart placed by a player between two pale oak logs with its own axis becomes awake instead of dormant.", 
    "tags": ["world", "log", "pale-oak-log", "creaking-heart", "block-state", "night", "player"], 
    "minecraftIds": ["minecraft:pale_oak_log", "minecraft:creaking_heart"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 5, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:creaking_heart"} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }, 
        "world": {"time": "13000"}
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "place_each", 
            "blocks": [
                { "pos": [0, 1, 0], "block": {"id": "minecraft:pale_oak_log", "axis": "y"} }, 
                { "pos": [0, 3, 0], "block": {"id": "minecraft:pale_oak_log", "axis": "y"} }  
            ]
        }, 
        { "at": 1, "do": "tp", "entity_alias": "player", "pos": [2.5, 2, 0.5], "rot": [90, 39] }, 
        {"at": 1, "do": "interact"}, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                {
                    "pos": [0, 2, 0], 
                    "is": {"id": "minecraft:creaking_heart", "axis": "y", "creaking_heart_state": "awake"}
                }, 
                {"slot": "hotbar1", "is": "empty"}
            ]
        }
    ], 
    "breakpoints": []
}

