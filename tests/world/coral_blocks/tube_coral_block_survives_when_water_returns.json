{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "tube_coral_block_survives_when_water_returns", 
    "description": "A tube coral block whose water is removed and then restored before the scheduled death tick fires re-checks for water and stays alive.", 
    "tags": ["coral", "coral-block", "water", "neighbor-update", "scheduled-tick"], 
    "minecraftIds": ["minecraft:tube_coral_block", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 2, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:water"} }, 
        { "at": 2, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:tube_coral_block"} }, 
        { "at": 10, "do": "remove", "pos": [1, 1, 0] }, 
        { "at": 30, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:water"} }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:tube_coral_block"} }
            ]
        }, 
        {
            "at": 150, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:tube_coral_block"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:water"           } }  
            ]
        }
    ], 
    "breakpoints": []
}

