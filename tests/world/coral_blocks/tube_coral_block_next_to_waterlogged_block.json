{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "tube_coral_block_next_to_waterlogged_block", 
    "description": "A waterlogged stone slab next to a tube coral block counts as water and keeps it alive.", 
    "tags": ["coral", "coral-block", "water", "waterlogged"], 
    "minecraftIds": ["minecraft:tube_coral_block", "minecraft:stone_slab"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 2, 
            "do": "place", 
            "pos": [1, 1, 0], 
            "block": {"id": "minecraft:stone_slab", "type": "bottom", "waterlogged": true}
        }, 
        { "at": 2, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:tube_coral_block"} }, 
        {
            "at": 3, 
            "do": "assert", 
            "checks": [
                { "pos": [1, 1, 0], "is": {"id": "minecraft:stone_slab", "waterlogged": true} }
            ]
        }, 
        {
            "at": 130, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:tube_coral_block"} }
            ]
        }
    ], 
    "breakpoints": []
}

