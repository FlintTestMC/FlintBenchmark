{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "tube_coral_block_player_placement_dry", 
    "description": "A Survival player placing a tube coral block on dry stone uses up the item, and the block dies to a dead tube coral block within 100 ticks.", 
    "tags": ["coral", "coral-block", "player", "placement", "dry"], 
    "minecraftIds": ["minecraft:tube_coral_block", "minecraft:dead_tube_coral_block", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 2, 1] ]
        }, 
        "player": {
            "inventory": { "hotbar1": {"id": "minecraft:tube_coral_block", "count": 1} }, 
            "selected_hotbar": 1, 
            "game_mode": "Survival"
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        {
            "at": 1, 
            "do": "fill", 
            "region": [ [0, 2, 0], [0, 2, 0] ], 
            "with": {"id": "minecraft:air"}
        }, 
        { "at": 2, "do": "tp", "entity_alias": "player", "pos": [0.5, 4, 0.5], "rot": [0, 90] }, 
        {"at": 3, "do": "interact"}, 
        { "at": 3, "do": "tp", "entity_alias": "player", "pos": [0.5, 3, 0.5] }, 
        {
            "at": 4, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:tube_coral_block"}                    }, 
                {                   "is": "empty"                             , "slot": "hotbar1" }  
            ]
        }, 
        {
            "at": 120, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 2, 0], "is": {"id": "minecraft:dead_tube_coral_block"} }
            ]
        }
    ], 
    "breakpoints": []
}

