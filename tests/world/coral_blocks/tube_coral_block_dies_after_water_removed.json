{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "tube_coral_block_dies_after_water_removed", 
    "description": "A living tube coral block whose only adjacent water is removed is still alive 5 ticks later and has become dead 110 ticks later.", 
    "tags": ["coral", "coral-block", "water", "neighbor-update", "death"], 
    "minecraftIds": ["minecraft:tube_coral_block", "minecraft:dead_tube_coral_block", "minecraft:water"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [3, 2, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [3, 2, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 2, "do": "place", "pos": [1, 1, 0], "block": {"id": "minecraft:water"} }, 
        { "at": 2, "do": "place", "pos": [0, 1, 0], "block": {"id": "minecraft:tube_coral_block"} }, 
        {
            "at": 70, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:tube_coral_block"} }
            ]
        }, 
        { "at": 70, "do": "remove", "pos": [1, 1, 0] }, 
        {
            "at": 75, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:tube_coral_block"} }, 
                { "pos": [1, 1, 0], "is": {"id": "minecraft:air"             } }  
            ]
        }, 
        {
            "at": 180, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 1, 0], "is": {"id": "minecraft:dead_tube_coral_block"} }
            ]
        }
    ], 
    "breakpoints": []
}

