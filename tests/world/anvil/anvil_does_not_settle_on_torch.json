{
    "$schema": "https://raw.githubusercontent.com/FlintTestMC/flint-core/refs/heads/main/flint-content/test_spec_schema.json", 
    "flintVersion": "1.0.0", 
    "name": "anvil_does_not_settle_on_torch", 
    "description": "A falling anvil passes through the torch (no collision) but cannot replace it, so it breaks apart at the torch's position and leaves the torch in place with air above it.", 
    "tags": ["world", "anvil", "falling-block", "non-replaceable"], 
    "minecraftIds": ["minecraft:anvil", "minecraft:torch", "minecraft:stone"], 
    "dependencies": [], 
    "setup": {
        "cleanup": {
            "region": [ [-1, 0, -1], [1, 8, 1] ]
        }
    }, 
    "timeline": [
        {
            "at": 0, 
            "do": "fill", 
            "region": [ [-1, 0, -1], [1, 1, 1] ], 
            "with": {"id": "minecraft:stone"}
        }, 
        { "at": 1, "do": "place", "pos": [0, 2, 0], "block": {"id": "minecraft:torch"} }, 
        { "at": 2, "do": "place", "pos": [0, 5, 0], "block": {"id": "minecraft:anvil", "facing": "north"} }, 
        {
            "at": 40, 
            "do": "assert", 
            "checks": [
                { "pos": [0, 5, 0], "is": {"id": "minecraft:air"  } }, 
                { "pos": [0, 3, 0], "is": {"id": "minecraft:air"  } }, 
                { "pos": [0, 2, 0], "is": {"id": "minecraft:torch"} }  
            ]
        }
    ], 
    "breakpoints": []
}

